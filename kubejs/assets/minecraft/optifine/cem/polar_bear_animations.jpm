			"var.turnL": "if( !is_riding && var.tq<0, 1, 0 )*var.idle*(1-var.swim)*0",
			"var.rr": "if( varb.pfc, var.rr, !equals(rot_y,var.pre_roty,1), rot_y, age>9 && !is_riding && var.idle>0.98 && var.tp>0, var.rr, rot_y )",
			"var.NAlook": " clamp( if( varb.pfc, var.NAlook, head_pitch==0 && !is_aggressive && is_on_ground && (  -1 +sin(var.id +(age+limb_swing)/88 )*3  )>0  , var.NAlook  +0.8 *frame_time, var.NAlook  -0.8 *frame_time ), 0, max(0, 1 -var.run ) )",
			"var.NAshake": "clamp( if( varb.pfc, var.NAshake, !is_aggressive && is_on_ground && (-398.7 +sin(var.id +(age+limb_swing)/250)*400)>0.9, var.NAshake +1.6 *frame_time, var.NAshake -0.8 *frame_time ), 0, max(0, 1 -var.warn ) )",
			"var.Nlook": "0.5-0.5*cos( var.NAlook*pi )",
			"var.Nshake": "0.5-0.5*cos( pow( var.NAshake, 3)*pi )",
			"var.Created_by_FreshLX_for_Fresh_Animations": "1"
