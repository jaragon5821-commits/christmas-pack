		},
		{
			"var.NearR": "if( varb.pfc, var.NearR, between( cos( var.id+age/210 +cos( (var.id+age/210)*1.3 )*6 /( sin( (var.id+age/210)*1.7 )+5 ) ), 0, 0.01 ), 1, max( 0, var.NearR -frame_time*2.5 ) )",
			"var.NearL": "if( varb.pfc, var.NearL, between( sin( var.id+age/180 +sin( (var.id+age/180)*1.3 )*6 /( cos( (var.id+age/180)*1.7 )+5 ) ), 0, 0.01 ), 1, max( 0, var.NearL -frame_time*2.5 ) )",
			"right_ear.rx": "torad( 10*(1-var.swim)  +25*sin( age*1.3)*sin(pow(var.NearR,2)*pi)*(1-var.Nshake)*var.walk  +70*var.aggro  )  +torad(-40*cos(var.t_rland*8)*var.rland )",
			"left_ear.rx": " torad( 10*(1-var.swim)  -40*cos( age*1.3)*sin(pow(var.NearL,2)*pi)*(1-var.Nshake)*var.walk  +70*var.aggro  )  +torad(-40*cos(var.t_rland*8)*var.rland )",
			"right_ear.ry": "torad( 10 +clamp(torad( 12 +var.hy/2), -20, 80 )  -70*sin(pi/6+age*1.3)*sin(pow(var.NearR,2)*pi)*(1-var.Nshake)*var.walk +45*min(1,var.swim*3) +120*var.aggro  )  +torad( 25*var.Nshake )",
			"left_ear.ry": " torad(-10 +clamp(torad(-12 +var.hy/2), -80, 20 )  +70*cos(pi/6+age*1.3)*sin(pow(var.NearL,2)*pi)*(1-var.Nshake)*var.walk -45*min(1,var.swim*3) -120*var.aggro  )  +torad(-25*var.Nshake )",
			"right_ear.rz": "torad(-10*cos(var.t_rland*3)*var.rland  )  +( torad(-8) -cos(-pi/4+var.id+age/1.3) )*var.Nshake",
			"left_ear.rz": " torad( 10*cos(var.t_rland*3)*var.rland  )  +( torad( 8) -cos(-pi/4+var.id+age/1.3) )*var.Nshake",
			"right_ear.tz": "-if( varb.baby_model, 2.5, 4 ) +0.7*right_ear.ry",
			"left_ear.tz": " -if( varb.baby_model, 2.5, 4 ) -0.7*left_ear.ry",
			"right_ear.ty": "-if( is_child && !varb.baby_model, 2, 2.5 ) +var.aggro",
			"left_ear.ty": " -if( is_child && !varb.baby_model, 2, 2.5 ) +var.aggro",
			"right_ear.sx": "if( is_child && !varb.baby_model, 1.25, 1 )",
			"right_ear.sy": "right_ear.sx",
			"right_ear.sz": "right_ear.sx",
			"left_ear.sx": "if( is_child && !varb.baby_model, 1.25 ,1 )",
			"left_ear.sy": "left_ear.sx",
			"left_ear.sz": "left_ear.sx"
		},
		{
			"brows.ty": "clamp( -sin(hurt_time/5*pi)/8*hurt_time +head_pitch/50  +clamp( 6-18*sin(pi/10+var.It/3), 0, 1-max(0, cos(var.It/2.4-sin(var.It/1.2)/1.2) ) )/3*var.Nlook*if( is_child, -1, 1 ) +0.3*var.aggro, -0.5, 0.5 )",
			"var.blink": "pow( clamp((1.5 -abs(sin(var.r+age/11)*6))*clamp(-32 +cos((var.r+age/11)/1.5)*40 +cos((var.r+age/11)/4)*40, 0, 1), min(1,death_time/4), 1), 2 )",
			"var.pupil_x": "if( varb.baby_model, 0, -head_yaw/180 +clamp(  12*sin(pi/12+var.It ),-1,1)/3*clamp(-5+var.Nlook*6,0,1) )",
			"eyes.tz": "-if( varb.baby_model, 4, 6 ) -clamp( sqrt( pow(pos_x-player_pos_x, 2) +pow(pos_y-player_pos_y, 2) +pow(pos_z-player_pos_z, 2) ), 0, 128 )/800",
			"brows.tz": "(eyes.tz+6)/3",
			"r_pupil.tx": "-if( varb.baby_model, 2, 2.5 ) +clamp( var.pupil_x, -0.5, 0.5 )",
			"l_pupil.tx": " if( varb.baby_model, 2, 2.5 ) +clamp( var.pupil_x, -0.5, 0.5 )",
			"r_pupil.ty": "1 +if( varb.baby_model, 0, clamp(head_pitch/30, -0.5, 0)*(1-var.blink) )",
			"l_pupil.ty": "r_pupil.ty",
			"r_pupil.sy": "clamp(1 +r_pupil.ty-1 -brows.ty, 0, 1-var.blink)",
			"l_pupil.sy": "r_pupil.sy",
			"r_pupil.visible": "r_pupil.sy!=0 && r_pupil.sx!=0",
			"l_pupil.visible": "l_pupil.sy!=0 && l_pupil.sx!=0"
		},
		{
			"var.pre_roty": "rot_y",
			"var.pre_posy": "pos_y",
			"var.pre_warn": "var.warn",
			"var.pre_frame_counter": "frame_counter"
		}
	]
}