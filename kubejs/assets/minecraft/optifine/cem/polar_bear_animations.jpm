{
	"credit": "Created by FreshLX for Fresh Animations",
	"animations": [
		{
			"varb.pfc": "frame_counter == var.pre_frame_counter",
			"var.bodyrx": "if( varb.pfc, var.bodyrx, body.rx )",
			"var.hy": "clamp( 90*sin(torad(head_yaw)), -90, 90 )",
			"var.child_scale": "if(varb.21_2_plus && is_child, 1, 0)",
			"var.id": "random(id)*pi*4",
			"var.ls_offset": "if( varb.pfc, var.ls_offset, limb_speed>=if( is_child, 0.65, 0.77 ), var.ls_offset + frame_time*2 * limb_speed, var.ls_offset )",
			"var.ls": "limb_swing * if(varb.baby_model, 0.5, is_child, 0.3, 0.6) +var.ls_offset*if( varb.baby_model, 0, 1 )",
			"var.position": "if( varb.pfc, var.position, is_riding || !equals(pos_y,var.pre_posy,2), pos_y, pos_y*min(1,frame_time*16) +var.position*max(0,1-frame_time*16) )",
			"var.vs": "if( varb.pfc, var.vs, !equals(pos_y,var.pre_posy,2), 0, (var.position-pos_y) )",
			"var.Bt": "var.id +age/if(is_child, 50, 70)*pi*2",
			"var.St": "var.id +age/if(is_child, 12, 18)*pi +limb_swing/if(is_in_water, 2, 4) -pos_y/4",
			"var.It": "( var.id +age*if(is_child, 1.3, 1)*(0.7+0.3*random(id)) +sin( var.id +age*if(is_child, 1.3, 1)*(0.7+0.3*random(id))/33 )*9 )/21",
			"var.idl2": "max( 0, 1-limb_speed * 1.5 )*(1-var.swim)",
			"var.idle": "max( 0, 1-limb_speed * if( is_in_water, 6, 4 ) )",
			"var.move": "min( 1, limb_speed * if( is_in_water, 6, 4 ) )",
			"var.aggro": "clamp( if( varb.pfc, var.aggro, is_aggressive, var.aggro +4*frame_time, var.aggro -4*frame_time ), 0, 1 )",
			"var.t_warn": "clamp( if( var.aggro>0, sqrt( min( 1, -(var.bodyrx-pi/2)*0.91 ) ), varb.pfc, var.t_warn, is_on_ground && limb_speed<0.0001 && ( sin(var.id +(age+limb_swing)/123/if( is_child, 1, 2 ) )*5 -if( is_child, 4, 4.95 ) )>0, var.t_warn +1.3 *frame_time, var.t_warn -3 *frame_time ), 0, 1 )",
			"var.warn": "if( varb.pfc, var.warn, var.t_warn*min(1, frame_time*if( var.t_warn>var.pre_warn || limb_speed<0.7, 8, 20 )) +var.warn*max(0,1-frame_time*if( var.t_warn>var.pre_warn || limb_speed<0.7, 8, 20 )) )",
			"var.air": "clamp( if( varb.pfc, var.air, age>60 && !is_riding && !is_on_ground && !is_in_water, var.air +if(var.vs<0, 0.4, 6)*frame_time, var.air -6 *frame_time ), 0, 1 )",
			"var.run": "clamp( if( varb.pfc, var.run, limb_speed>=if( varb.baby_model, 0.57, is_child, 0.65, 0.77 ), var.run +6 *frame_time, var.run -3 *frame_time ), 0, max(0,1-var.swim-var.air-var.warn*2) )",
			"var.walk": "clamp(1-var.run-var.air, 0, (1-var.swim) )*if(is_child, 1.3, 1)",
			"var.swiA": "clamp(if(varb.pfc, var.swiA, !is_riding&&!is_on_ground&&is_in_water, var.swiA +0.8 *frame_time, var.swiA -2 *frame_time ), 0, 1 )",
			"var.swim": "clamp(-0.5 +var.swiA*2, 0, 1)",
			"var.hurt": "(hurt_time/10)*(hurt_time/10)*max(0, (1-hurt_time/10)*8 )",
			"var.t_claw": "clamp( if( varb.pfc, var.t_claw, var.t_warn<0.5 && in(var.t_claw,0,1), 0, var.t_claw + frame_time * if(var.t_warn<0.1,2,1) ), 0, 1 )",
			"var.claw": "( 0.5 -0.5*cos( sin( var.t_claw*pi )*pi ) )*var.aggro",
			"var.swipe": "sin( var.t_claw*pi/2 ) * ( 1 -cos( min( 1, var.t_claw*2 )*pi ) )/2*var.aggro",
			"varb.jumping": "!is_on_ground && !is_in_water && pos_y > var.pre_posy && age>9 || var.t_jump!=0",
			"varb.falling": "!is_on_ground && !is_in_water && pos_y < var.pre_posy",
			"var.t_land": "clamp( if( varb.pfc, var.t_land, (var.t_land==0 || var.t_land==1) && ( varb.falling || (var.t_warn<var.pre_warn&&var.t_warn>0.5) ), 0, var.t_land + frame_time*0.7 * if(varb.falling,4,2) ), 0, 1)",
			"var.t_jump": "clamp( if( varb.pfc, var.t_jump, (var.t_jump==1 && is_on_ground) || !varb.jumping , 0, var.t_jump + frame_time*0.7 * 2  ), 0, max(0,1-var.t_warn*2) )",
			"var.t_fall": "clamp( if( varb.pfc, var.t_fall, var.air>0.4, var.t_fall +6 *frame_time, var.t_fall -6 *frame_time ), 0, 1)",
			"var.fall_amp": "if( varb.pfc, var.fall_amp, max(0, var.fall_amp - frame_time * var.fall_amp * if(var.t_land<0.7, 3, 6) +if( !is_on_ground, var.vs/if(is_child, 2, 4)*frame_time*60, var.t_warn<var.pre_warn, 0.01*(1-limb_speed/2), 0 ) ) )",
			"var.jump": "sin( ( var.t_jump -pow( var.t_jump, 2 )/2 )*2*pi )*if(is_child, 1.5, 1.3)",
			"var.land": "sin( ( clamp(-0.2 +var.t_land*1.2, 0, 1) -pow(clamp(-0.2 +var.t_land*1.2, 0, 1 ),2 )/2 )*2*pi )*sqrt( clamp(var.fall_amp*2, 0, if(is_alive, 3, 0)) )",
			"var.fall": "clamp( if(age>9, var.vs, 0 ), -1.5, 1.5 )",
			"var.tr": "if( varb.pfc, var.tr, !equals(rot_y,var.pre_roty,1), rot_y, age>9 && var.tp> 0 && var.idle>0.98 || abs(rot_y-var.pre_roty)>0, var.tr, rot_y )",
			"var.tp": "if( varb.pfc, var.tp, age>9 && var.tp==0 && var.idle>0.98 && abs(rot_y-var.pre_roty)>0, 1, max(0, var.tp -1.5 *frame_time ) )",
			"var.tq": "todeg( clamp( rot_y -var.tr, -pi/2, pi/2 ) )",
