			"leg2.tz": "(  if( varb.baby_model, 9, 8 ) +( -0.4 +1.8*sin( pi/6 +var.St )  )*max(0.5,var.move)*var.swim  +( (-1-3.5*sin(var.ls +sin(var.ls)/2.5 ) )*max(var.move, 0.1) )*var.walk*if( varb.baby_model, 0.5, 1 )  +( sin(  var.ls)*6 +0.5 )*limb_speed*var.run*if(is_child && !varb.baby_model, 1, 1.3)  +( (0.5+limb_speed)*cos(var.t_jump*pi/2)*var.jump -if( varb.baby_model, 1, 3 )*max(0,var.fall) +4*min(0,var.fall) +cos(var.St*1.5)*2*var.t_fall )  +((-7 +7*cos(torad(var.tq*var.tp)) -4*sin(torad(var.tq*var.tp)) )*( 1-cos(clamp(2.3-var.tp*2.7,0,1)*pi) )/2*var.turnR +(-7 +7*cos(torad(-var.tq*(1-var.tp))) -4*sin(torad(-var.tq*(1-var.tp))) )*( 1-cos(clamp(-0.2+var.tp*3,0,1)*pi) )/2*var.turnL)  ) * (1-0.5*var.child_scale)",
			"leg3.tz": "( -if( varb.baby_model, 9, 7.3 ) +( -2*cos( pi/9 +var.St -cos(pi/6+var.St)/2.5 ) )*max(0.5,var.move)*var.swim  +(  -2.5*cos(var.ls +cos(var.ls)/2.5 )  *max(var.move, 0.2) )*var.walk*if( varb.baby_model, 0.5, 1 )*(1-var.claw) +(-cos(-pi/3+var.ls)*6 -1 )*limb_speed*var.run*if(is_child && !varb.baby_model, 1, 1.3)  +( (1+3*limb_speed)*cos(var.t_jump*pi  )*var.jump +if( varb.baby_model, 6, 2 )*max(0,var.fall) -2*min(0,var.fall) +sin(var.St*1.5)*2*var.t_fall )  +(( 5 -5*cos(torad(var.tq*var.tp)) +4*sin(torad(var.tq*var.tp)) )*( 1-cos(clamp(2.3-var.tp*2.7,0,1)*pi) )/2*var.turnR +( 5 -5*cos(torad(-var.tq*(1-var.tp))) +4*sin(torad(-var.tq*(1-var.tp))) )*( 1-cos(clamp(-0.2+var.tp*3,0,1)*pi) )/2*var.turnL)*(1-var.warn)  +if( varb.baby_model, 15 -2*var.aggro, 12 -6*var.aggro )*(1-limb_speed/2)*sin(var.warn*pi/2) +3*sin(var.warn*pi)  +4*(cos( max(0,-0.3+var.swipe*1.3 )*pi*2 )-1)*(1-var.swipe)  ) * (1-0.5*var.child_scale)",
