	quest.0139074B2CA1C12A.quest_desc: ["Moves items around town so workers aren't stuck waiting."]
	quest.0139074B2CA1C12A.title: "The Courier"
	quest.01B50F5E6733E669.quest_desc: ["&fSnowy roofs&r come in blocks, stairs and slabs: snowballs on top of bricks, stone or spruce. Instant winter village."]
	quest.01B50F5E6733E669.title: "Snow on the Roof"
	quest.01FBCF491FDEEF9D.quest_desc: [
		"A compass and a map, the oldest travel kit there is."
		"&7Your minimap and big map keys are in the Chop's Handbook.&r"
	]
	quest.01FBCF491FDEEF9D.title: "Know Where You Are"
	quest.030E0540A7D41FAE.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.030E0540A7D41FAE.title: "Tracking Collar"
	quest.039FD10FA92A2903.quest_desc: ["Coal Heart + blaze powder + compass makes a &6Forge Ember&r. It only burns in the &cNether&r, where its trail leads to the Clinker Forge."]
	quest.039FD10FA92A2903.title: "Follow the Ember"
	quest.03DB65DB715F1C1F.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.03DB65DB715F1C1F.title: "Icing Piper"
	quest.0451B265D4848AAE.quest_desc: [
		"Something is out there that hates Christmas. When &4Santy Claws&r comes for your town, rally your colony and drive him off."
		""
		"&7Naughty players beware: he remembers who's on his side.&r"
	]
	quest.0451B265D4848AAE.title: "Santy Claws"
	quest.045E309442620EE8.quest_desc: ["Small chests in any dungeon sometimes hold one."]
	quest.045E309442620EE8.title: "Gift Crate"
	quest.053CEA6015F58AE1.quest_desc: ["The Nutcracker King's crown. Trophy, nothing more. Probably."]
	quest.053CEA6015F58AE1.title: "Clockwork Crown"
	quest.057E4C2037C4B1AF.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.057E4C2037C4B1AF.title: "Chain Gang Lantern"
	quest.05FED01396D7B45D.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.05FED01396D7B45D.title: "Glass Bell Helm"
	quest.0736133653784D3E.quest_desc: ["Tools and armour for your workers and guards."]
	quest.0736133653784D3E.title: "The Blacksmith"
	quest.08EB363841750EFF.quest_desc: ["The best way to get around, once you've earned it."]
	quest.08EB363841750EFF.title: "Wings"
	quest.0A9BFA4B00A5303A.quest_desc: [
		"The reindeer were never meant to stay frozen. Their hounds disagree."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.0A9BFA4B00A5303A.title: "Find the Frozen Reindeer Stables"
	quest.0BB8EB9998EE097E.quest_desc: ["Carry both the &aNice List Quill&r and the &6Candle of Vigil&r out of the Citadel."]
	quest.0BB8EB9998EE097E.title: "Rewrite the List"
	quest.0C62648B95A8B3B6.quest_desc: ["Digs a mine shaft and brings back ore and stone."]
	quest.0C62648B95A8B3B6.title: "The Miner"
	quest.0C6E03ED204771AE.quest_desc: ["Keep giving, decorating and helping. A town that loves you is a town that throws a &aparty&r."]
	quest.0C6E03ED204771AE.title: "On the Nice List"
	quest.0D011F243249EAAC.quest_desc: ["Run, run, as fast as you can."]
	quest.0D011F243249EAAC.title: "Gingerbread Man"
	quest.0D165327A60A26E4.quest_desc: [
		"Your colony can run itself now. Decorate it: wreaths on the doors, lights on the roofs."
		"&7Then invite a friend over to see it.&r"
	]
	quest.0D165327A60A26E4.title: "A Proper Christmas Town"
	quest.0D419B1BAB41DB90.quest_desc: ["The dungeon's guardian always carries this. Clear the &cboss trial&r to claim it."]
	quest.0D419B1BAB41DB90.title: "Rolling Pin"
	quest.0F9CE372C45513F3.quest_desc: ["Adults study here to raise their skills."]
	quest.0F9CE372C45513F3.title: "The Library"
	quest.0F9EBC2267755F33.quest_desc: [
		"Drop items or &6Colony Bucks&r into the &cDonation Kettle&r. Your colony puts them to use, and generosity raises your Festivity."
		""
		"&7Bucks and materials count about the same, so give whatever you have spare.&r"
	]
	quest.0F9EBC2267755F33.title: "The Donation Kettle"
	quest.1138382B2D7A6CD6.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.1138382B2D7A6CD6.title: "Sugarplum Charm"
	quest.1200DA1932ED9F77.quest_desc: [
		"Every lump of naughty-list coal starts here. Bring fire resistance."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.1200DA1932ED9F77.title: "Find Claws' Coal Furnace"
	quest.13432A8D800CCA1A.quest_desc: ["Builders build everything else. Look out for the &cChristmas styles&r when you pick a building style."]
	quest.13432A8D800CCA1A.title: "Hire a Builder"
	quest.14044D534DA9A96A.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.14044D534DA9A96A.title: "Clockwork Drummer"
	quest.1521F02191A50624.quest_desc: ["Fallen citizens rest here, and can be brought back."]
	quest.1521F02191A50624.title: "The Graveyard"
	quest.15DBE31B95D0A49C.quest_desc: ["Coal Heart + Clinker Core + dragon's breath + 4 ender pearls. It only points in &5the End&r, to the cold between the islands."]
	quest.15DBE31B95D0A49C.title: "The Naughty Compass"
	quest.161DDCC336EDBE31.quest_desc: ["Sick citizens get treated here instead of wandering in a daze."]
	quest.161DDCC336EDBE31.title: "The Hospital"
	quest.168C3F6F12D5E797.quest_desc: [
		"Where Claws keeps the elves who said no. Pickaxes, chains and a warden who never sleeps."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.168C3F6F12D5E797.title: "Find the Elf Prison Mines"
	quest.16E750E10C5C7844.quest_desc: ["A common find in this dungeon's chests."]
	quest.16E750E10C5C7844.title: "Elf Lockpick"
	quest.172176007669D401.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.172176007669D401.title: "Crucible Helm"
	quest.173BB01D220B7A87.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.173BB01D220B7A87.title: "Nice List Quill"
	quest.1754F854F9B8637A.quest_desc: [
		"A maze of iced walls and sugar traps. The gingerbread inside did not bake itself."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.1754F854F9B8637A.title: "Find the Gingerbread Labyrinth"
	quest.178EE23444BCC392.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.178EE23444BCC392.title: "Gnome Muzzle"
	quest.1B8AD3B5745CCF22.quest_desc: [
		"Your colonists post what they need on the &6Requests Board&r. Fill requests to keep them happy and earn Festivity."
		""
		"&7Right-click the board to see what's wanted.&r"
	]
	quest.1B8AD3B5745CCF22.title: "The Requests Board"
	quest.1D61A92B04F67EE7.quest_desc: ["A proper army for when the Naughty List comes knocking."]
	quest.1D61A92B04F67EE7.title: "The Barracks"
	quest.1D68216F7783C1C9.quest_desc: ["A hearty mountain meal. Not Rudolph. Probably."]
	quest.1D68216F7783C1C9.title: "Alpine Roast"
	quest.1DFAD3D9A998A217.quest_desc: ["A common find in this dungeon's chests."]
	quest.1DFAD3D9A998A217.title: "Festive Lasso"
	quest.1F344F35A265534E.quest_desc: [
		"Every colony starts with a &6Supply Camp&r (on land) or a &6Supply Ship&r (on water)."
		"Place it and it turns into your first stockpile and a Town Hall to build."
	]
	quest.1F344F35A265534E.title: "A Place to Call Home"
	quest.1F4DAA1E1FF27843.quest_desc: ["Find wild cabbage and plant them."]
	quest.1F4DAA1E1FF27843.title: "Cabbage"
	quest.1F71E101707292A4.quest_desc: ["Research unlocks new buildings, better guards and more."]
	quest.1F71E101707292A4.title: "The University"
	quest.208F625365053422.quest_desc: ["Herbal Brews' kettle brews teas and coffee. Grow tea from Tea Blossoms, dry the leaves, then brew."]
	quest.208F625365053422.title: "Put the Kettle On"
	quest.20D58F67543C78A6.quest_desc: ["A stove heats anything you set on top of it. Pots and skillets need heat."]
	quest.20D58F67543C78A6.title: "Light the Stove"
	quest.20EB26356651CA27.quest_desc: ["Food from any nearby water. Great for a winter town."]
	quest.20EB26356651CA27.title: "The Fisher"
	quest.21C75B4E8A4B069C.quest_desc: ["Put an ornament in a &6Glassblower&r to swap it between &b8 styles&r: candy stripe, snowflake, glitter, ribbed, mercury glass, faceted, jeweled and painted scene."]
	quest.21C75B4E8A4B069C.title: "The Glassblower"
	quest.223558D92D008BB5.quest_desc: ["Soups, stews and pasta. Put it on the stove and add ingredients."]
	quest.223558D92D008BB5.title: "The Cooking Pot"
	quest.226095EDCE9A7A9D.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.226095EDCE9A7A9D.title: "Reindeer Harness"
	quest.2280AD84E37C1EDA.quest_desc: [
		"The toys still roll off the line. Somebody wound them up wrong."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.2280AD84E37C1EDA.title: "Find the Toy Factory"
	quest.24498DBE8CB2D5D2.quest_desc: ["The official drink of snowy evenings. Cook it in the pot."]
	quest.24498DBE8CB2D5D2.title: "Hot Cocoa"
	quest.26AF58C8DE1CA6FC.quest_desc: ["The dungeon's guardian always carries this. Clear the &cboss trial&r to claim it."]
	quest.26AF58C8DE1CA6FC.title: "Warden's Keyring"
	quest.27BD0BB60E8EE61E.quest_desc: ["A common find in this dungeon's chests."]
	quest.27BD0BB60E8EE61E.title: "Naughty List Page"
	quest.2834A320ED08723D.quest_desc: ["Prefer a harbour town? The &6Supply Ship&r does the same job on water."]
	quest.2834A320ED08723D.title: "...or Arrive by Sea"
	quest.2904D4631C1CD998.quest_desc: [
		"It's always nearly Christmas here. &bSnow&r, &ccolonies&r and a town that remembers how you treat it."
		""
		"Your &6Festivity&r score tracks whether you're on the &anice&r or &cnaughty&r list. Helping villagers, decorating and giving raise it; hurting villagers, griefing and stealing lower it."
		""
		"&7New players get a short grace period before anything counts against them.&r"
	]
	quest.2904D4631C1CD998.title: "Welcome to Chop's Christmas"
	quest.29B05AA51661D1D9.quest_desc: ["Cinnamon and spice in a cup."]
	quest.29B05AA51661D1D9.title: "Christmas Tea"
	quest.2A10EB27BE6039F9.quest_desc: ["Pick Green Tea Leaves and dry them out. Ready for the kettle."]
	quest.2A10EB27BE6039F9.title: "Dried Tea Leaves"
	quest.2ADE34407E989A9F.quest_desc: ["A common find in this dungeon's chests."]
	quest.2ADE34407E989A9F.title: "Candy Cane Grapple"
	quest.2B515835609527B5.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.2B515835609527B5.title: "Candle Of Vigil"
	quest.2B7CFDA435474D81.quest_desc: ["A common find in this dungeon's chests."]
	quest.2B7CFDA435474D81.title: "Mine Cart Charm"
	quest.2CD104F5F6C42608.quest_desc: [
		"The heart of the colony. Place it, right-click it, and name your town."
		"&7Citizens start arriving once there are beds for them.&r"
	]
	quest.2CD104F5F6C42608.title: "The Town Hall"
	quest.2D181E621D93B5E3.quest_desc: ["A common find in this dungeon's chests."]
	quest.2D181E621D93B5E3.title: "Coal Heart Shard"
	quest.2DE4E0DD2FA32BF4.quest_desc: ["Flaky. Buttery. Worth it."]
	quest.2DE4E0DD2FA32BF4.title: "Croissant"
	quest.2E1076248D3705B2.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.2E1076248D3705B2.title: "Ember Walker Boots"
	quest.30C17DDFB4D46937.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.30C17DDFB4D46937.title: "Conveyor Greaves"
	quest.32CF06A344E6243D.quest_desc: ["Add &eglowstone dust&r to any ornament and it lights up. Small ones work as Christmas lanterns."]
	quest.32CF06A344E6243D.title: "Make It Glow"
	quest.3372B096386B0B31.quest_desc: ["Villages connect by roads. Follow one and see where it goes."]
	quest.3372B096386B0B31.title: "Visit a Village"
	quest.341E64D86C318400.quest_desc: ["A seasonal classic."]
	quest.341E64D86C318400.title: "Eggnog"
	quest.350ED68F4D3729FA.quest_desc: ["The &62x2&r and &63x3&r picture windows show one big picture across the whole square. They line up to the world grid, so shuffle your square a block if the picture looks cut."]
	quest.350ED68F4D3729FA.title: "Cathedral Glass"
	quest.369075A72095C2DE.quest_desc: ["Plain glass, stained glass and panes connect too. Build a 3x3 and watch the inner lines disappear."]
	quest.369075A72095C2DE.title: "Seamless Glass"
	quest.36DC7DDF932F9FDD.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.36DC7DDF932F9FDD.title: "Wind Up Key"
	quest.385B3C2DA6275C49.quest_desc: [
		"Nothing gets built without one. Give them a hut, then give them materials."
		"&7Tip: open the builder's hut to see what it still needs.&r"
	]
	quest.385B3C2DA6275C49.title: "Hire a Builder"
	quest.392B9C20B2AE16BE.quest_desc: [
		"A gnome the size of a house, walking on lava and throwing clinker bombs. Bring fire resistance."
		""
		"&7He drops a &6Clinker Core&r.&r"
	]
	quest.392B9C20B2AE16BE.title: "The Clinker Forgemaster"
	quest.3ADA85706D398A24.quest_desc: [
		"From &6December 1st&r, open today's door on the town &cAdvent Calendar&r for a small gift. Tick this off once you have."
		""
		"&7Come back every day: there are 24 doors.&r"
		"&7Doors open from December 1 (real date), one per day.&r"
	]
	quest.3ADA85706D398A24.title: "Open Today's Door"
	quest.3BED91A3FC2CAADB.quest_desc: ["The dungeon's guardian always carries this. Clear the &cboss trial&r to claim it."]
	quest.3BED91A3FC2CAADB.title: "Shadow Cloak"
	quest.3C168D98CCC87C13.quest_desc: ["A common find in this dungeon's chests."]
	quest.3C168D98CCC87C13.title: "Gift Wrap Bandolier"
	quest.3CB2F648AF644AA0.quest_desc: ["Iron Furnaces smelt faster than the vanilla furnace. Build an Iron Furnace, or craft an &6Upgrade&r and use it on a furnace you already placed."]
	quest.3CB2F648AF644AA0.title: "Hotter Fires"
	quest.3D86A1F2F923B432.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.3D86A1F2F923B432.title: "Ember Pick"
	quest.3F5CFBC6DE09EFF9.quest_desc: ["A common find in this dungeon's chests."]
	quest.3F5CFBC6DE09EFF9.title: "Globe Keeper's Hat"
	quest.3F8F77A04DC3BD28.quest_desc: [
		"A knife cuts grass for seeds, slices food and harvests straw."
		"Start with flint; upgrade later."
	]
	quest.3F8F77A04DC3BD28.title: "A Sharp Start"
	quest.408ABAA7FDB5CE7D.quest_desc: ["Sleds are quick on snow and ice. Hitch a wolf, or a friend, to pull it."]
	quest.408ABAA7FDB5CE7D.title: "A Proper Sled"
	quest.40F9DB57DD089F7E.quest_desc: ["Craft a plain &7silver ornament&r. Dye it any colour, or hang the small one under a ledge like a lantern."]
	quest.40F9DB57DD089F7E.title: "Your First Ornament"
	quest.415079BBA55B7B46.quest_desc: ["Found in any dungeon. Sing to a village."]
	quest.415079BBA55B7B46.title: "Carol Book"
	quest.42C5C2979469C5AD.quest_desc: ["Where Claws came from. Go carefully."]
	quest.42C5C2979469C5AD.title: "The Edge of the World"
	quest.42FE26CC526FB3F1.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.42FE26CC526FB3F1.title: "Snowball Cannon"
	quest.43CDFA0AA06A3706.quest_desc: ["Grow ginger from wild Ginger Flowers to bake these."]
	quest.43CDFA0AA06A3706.title: "Gingerbread Cookie"
	quest.44AAB9911D351DEE.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.44AAB9911D351DEE.title: "Gumdrop Boots"
	quest.457606E4CD7D8FF0.quest_desc: ["Cooks raw food so your citizens stay fed and happy."]
	quest.457606E4CD7D8FF0.title: "The Restaurant"
	quest.46B8E2F17C2DA0DA.quest_desc: ["Winter is long here: the seasons spend most of their time in &bwinter&r. Get a fire going and find some food."]
	quest.46B8E2F17C2DA0DA.title: "Warm Hands"
	quest.46FF26BAEE78F630.quest_desc: ["Bake one for a friend's birthday, or just for Tuesday."]
	quest.46FF26BAEE78F630.title: "Strawberry Cake"
	quest.4808B74437F5E9A0.quest_desc: ["Cuts trees and replants them. Your builders will need the wood."]
	quest.4808B74437F5E9A0.title: "The Forester"
	quest.489C90EB0327ABE1.quest_desc: ["Craft 8 paper with a dye to make wrapping paper, then swap patterns at the Loom Table. Finish it off with a &cgift bow&r."]
	quest.489C90EB0327ABE1.title: "Wrap It Up"
	quest.4941CAB3DC5977F4.quest_desc: ["A common find in this dungeon's chests."]
	quest.4941CAB3DC5977F4.title: "Tin Soldier Box"
	quest.4A61FA92A5CAD3D6.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.4A61FA92A5CAD3D6.title: "Snowman Core"
	quest.4B36866F35EFC509.quest_desc: ["Bread, cakes and cookies in bulk. Very on-theme."]
	quest.4B36866F35EFC509.title: "The Bakery"
	quest.4C12EC1A09B6199B.quest_desc: ["Iron Furnaces has its own Christmas look. Use this on an Iron Furnace to dress it up for the season."]
	quest.4C12EC1A09B6199B.title: "A Festive Furnace"
	quest.4C1A0F15AFE70002.quest_desc: [
		"Fire in this world is &cdangerous&r. Once something catches, the flames &lspread&r to every wooden block next to it."
		""
		"Burning wood smoulders, then turns into &8charred&r blocks. A house can burn down to a &8black shell&r in minutes."
		""
		"&bRain&r puts fires out. &cSnow won't save your building&r: the fire burns just as fast while it snows. You're the fire brigade."
		""
		"Modded furniture, roofs and Christmas decorations don't char, they just &cburn away&r. Keep fires away from your decor!"
	]
	quest.4C1A0F15AFE70002.title: "Where There's Smoke..."
	quest.4C1A0F15AFE70004.quest_desc: [
		"Water stops any burning block. Grab a &bwater bucket&r and keep it on your hotbar when you light anything."
		""
		"Your reward is a &cFire Extinguisher&r: spray it at flames to put out a whole fire quickly."
		""
		"&7Colony buildings that burn get rebuilt by your builders, once a day after the fire is out. Your own builds and villager homes are yours to fix.&r"
		""
		"&4Careful:&r setting fires that hurt villages costs &cFestivity&r."
	]
	quest.4C1A0F15AFE70004.title: "Bucket Brigade"
	quest.4D39527FB6F145E4.quest_desc: ["A tray of fudge for the table."]
	quest.4D39527FB6F145E4.title: "Fudge"
	quest.4D3E91A1498D9092.quest_desc: [
		"Claws was born in the End, and this is where he comes back to full size. Bring friends: he's built for four."
		""
		"Break his &bFrost Pillars&r or he heals. A &6Lantern Gnome&r near him stuns him for a moment."
		""
		"&7Everyone nearby gets a &bHeart of Winter&r.&r"
	]
	quest.4D3E91A1498D9092.title: "Santy Claws, Ascendant"
	quest.4EBA7E4DDE58B17C.quest_desc: ["A common find in this dungeon's chests."]
	quest.4EBA7E4DDE58B17C.title: "Toy Soldier Banner"
	quest.50FED7AF37E9824B.quest_desc: [
		"Every colony starts somewhere. Place a &6Supply Camp&r (or Supply Ship) to begin your MineColonies town."
		""
		"&7Colonists are MCA villagers too: they have names, moods and families.&r"
	]
	quest.50FED7AF37E9824B.title: "Pitch the Supply Camp"
	quest.5123643062E40A7B.quest_desc: ["Faster again. Great next to a busy kitchen."]
	quest.5123643062E40A7B.title: "Gold Furnace"
	quest.51DA7BCB2D21F5E5.quest_desc: ["The Hound Master's horn. It's somewhere in the biggest chests of the stables."]
	quest.51DA7BCB2D21F5E5.title: "Hound Master's Horn"
	quest.52A5CFFD451AECD6.quest_desc: ["Wool makes beds, banners and the &cChristmas sweater wool&r you'll find later on the Loom Table."]
	quest.52A5CFFD451AECD6.title: "Wool Socks"
	quest.5302A2E581014C43.quest_desc: ["Each Residence houses more citizens. More citizens, more workers."]
	quest.5302A2E581014C43.title: "Homes for Everyone"
	quest.5482DB3C78172BE3.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.5482DB3C78172BE3.title: "Frostbitten Saddle"
	quest.5521D254E8414BD8.quest_desc: ["Sugar plus a snowball makes &ficing&r. Add sprinkles, slabs and &fdrips&r that hang off your gingerbread rooftops."]
	quest.5521D254E8414BD8.title: "Gingerbread Architecture"
	quest.55A05692393FD551.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.55A05692393FD551.title: "Cookie Cutter Shield"
	quest.55F22D8F057A5FF9.quest_desc: ["Points to where you last died. Graves are on, so this leads you right back to your stuff."]
	quest.55F22D8F057A5FF9.title: "Never Lost Again"
	quest.56FBF7F544C4DC9F.quest_desc: ["Build your &6Town Hall&r. Your colony is now on the map, and Festivity starts counting what it does."]
	quest.56FBF7F544C4DC9F.title: "Town Hall"
	quest.57002F8B008AC71D.quest_desc: ["The base for breads, croissants and pies."]
	quest.57002F8B008AC71D.title: "Dough"
	quest.59448DA9CCBE2F17.quest_desc: ["The secret to half of the festive recipes."]
	quest.59448DA9CCBE2F17.title: "Cinnamon Sticks"
	quest.5A7CDA5D95E0F5D6.quest_desc: ["Find wild tomatoes and plant them."]
	quest.5A7CDA5D95E0F5D6.title: "Tomatoes"
	quest.5BD1DFF736A97117.quest_desc: ["Compost turns into rich soil, which makes crops grow faster."]
	quest.5BD1DFF736A97117.title: "Rich Soil"
	quest.60CEEFC024E0A4BA.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.60CEEFC024E0A4BA.title: "Freed Elf Whistle"
	quest.617ED107310721E6.quest_desc: ["Central storage. Couriers carry items between huts from here."]
	quest.617ED107310721E6.title: "The Warehouse"
	quest.630F70C971E520A9.quest_desc: ["One block in the Nether is eight in the Overworld. Portals make long trips short."]
	quest.630F70C971E520A9.title: "Through the Portal"
	quest.64B856C161BE8C0E.quest_desc: ["A rare find: look in the dungeon's &6vaults&r and big chests."]
	quest.64B856C161BE8C0E.title: "Sleigh Bells"
	quest.659A070A3E0E32CA.quest_desc: ["Let's Do Bakery's workstation for cakes, cupcakes and pastries."]
	quest.659A070A3E0E32CA.title: "The Caking Station"
	quest.65AFE2F7DC7DC725.quest_desc: ["Roll out dough for cookies and gingerbread."]
	quest.65AFE2F7DC7DC725.title: "Rolling Pin"
	quest.662E9D09F0746B30.quest_desc: ["The fastest way across a frozen lake is... on top of it. Boats fly on ice."]
	quest.662E9D09F0746B30.title: "Set Sail"
	quest.6839A2EBF24292EE.quest_desc: ["A guard to keep the coal gnomes and worse away at night."]
	quest.6839A2EBF24292EE.title: "The Guard Tower"
	quest.68C74ABC472EAD02.quest_desc: [
		"He hides behind waves of tin soldiers and a giant &cNutcracker King&r. Beat the king first or he can't be touched."
		""
		"&7He drops a &6Coal Heart&r.&r"
	]
	quest.68C74ABC472EAD02.title: "The Twisted Toymaster"
	quest.69BC1FE49C520ADC.quest_desc: ["Warm, spiced and best shared."]
	quest.69BC1FE49C520ADC.title: "Apple Cider"
	quest.6A3A83015EC46B62.quest_desc: ["The dungeon's guardian always carries this. Clear the &cboss trial&r to claim it."]
	quest.6A3A83015EC46B62.title: "Snow Globe"
	quest.6A621F2B9F6AA762.quest_desc: ["A common find in this dungeon's chests."]
	quest.6A621F2B9F6AA762.title: "Frozen Lure"
	quest.6A6892A5D8F03CB1.quest_desc: ["A common find in this dungeon's chests."]
	quest.6A6892A5D8F03CB1.title: "Jingle Boots"
	quest.6A6A74D65F02B4E5.quest_desc: [
		"Claws' own fortress, where the Naughty List is written. Read it, then rewrite it."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.6A6A74D65F02B4E5.title: "Find the Naughty Citadel"
	quest.6B424FC2A81A5ADA.quest_desc: ["The dungeon's guardian always carries this. Clear the &cboss trial&r to claim it."]
	quest.6B424FC2A81A5ADA.title: "Drum Major's Baton"
	quest.6C046614E90DB8DA.quest_desc: ["The &6Loom Table&r turns wool into &cFair Isle sweater wool&r and paper into &cwrapping paper&r (stripes, dots, snowflakes and plaid)."]
	quest.6C046614E90DB8DA.title: "The Loom Table"
	quest.6CC1BE6A7F7D77F1.quest_desc: [
		"Minecarts and powered rails link your base to your colony."
		"&7Colony roads are nice too, but rails don't get lost.&r"
	]
	quest.6CC1BE6A7F7D77F1.title: "Lay Some Track"
	quest.6CC66BD9250ECF65.quest_desc: ["Sticky, sweet and fresh from the oven."]
	quest.6CC66BD9250ECF65.title: "Cinnamon Roll"
	quest.6D23AE2FBD86FD6D.quest_desc: ["Find wild rice and plant them."]
	quest.6D23AE2FBD86FD6D.title: "Rice"
	quest.6F69115F5FA8C5EC.quest_desc: ["Clear any dungeon, then craft a &6Toymaker's Ticket&r (paper + compass + coal). Use it to learn where the &eTwisted Toymaster&r waits."]
	quest.6F69115F5FA8C5EC.title: "Admit One"
	quest.6FAB609FB90E358E.quest_desc: [
		"A whole town under glass, at the bottom of the sea. Hold your breath."
		""
		"&7Each dungeon hides treasure found nowhere else. Common finds are in its chests; rare ones in its vaults; the best one comes from its boss.&r"
	]
	quest.6FAB609FB90E358E.title: "Find the Sunken Snow Globe"
	quest.73FEC5FB13D5BC3E.quest_desc: ["Fry food on the stove, or swing it in a pinch."]
	quest.73FEC5FB13D5BC3E.title: "The Skillet"
	quest.740CB0052DBB0B07.quest_desc: ["Fields of wheat, carrots and more. Feeds the whole town."]
	quest.740CB0052DBB0B07.title: "The Farmer"
	quest.74D099FD565F65B2.quest_desc: ["&cLarge ornaments&r are full blocks, perfect for town squares and giant trees."]
	quest.74D099FD565F65B2.title: "Go Big"
	quest.7560CAA8AC9B59C7.quest_desc: ["Children learn here and grow up as better workers."]
	quest.7560CAA8AC9B59C7.title: "The School"
	quest.75A83F9ACBA99D8A.quest_desc: ["Carved ice (snowflake, swirl, star), clear ice bricks and &bglowing ice&r. Find them all at the Glassblower from packed ice."]
	quest.75A83F9ACBA99D8A.title: "Ice Palace"
	quest.769343B9F9389B33.quest_desc: ["Place food on it and right-click with your knife to slice it."]
	quest.769343B9F9389B33.title: "The Cutting Board"
	quest.786C372D3D8A8224.quest_desc: ["Find a saddle in a chest, tame a horse, and ride."]
	quest.786C372D3D8A8224.title: "Saddle Up"
	quest.79619769AC865C69.quest_desc: ["Visitors stop at the Tavern. Some of them can be hired if you pay their price."]
	quest.79619769AC865C69.title: "The Tavern"
	quest.79891DC5E15E4A6B.quest_desc: ["Serious smelting speed."]
	quest.79891DC5E15E4A6B.title: "Diamond Furnace"
	quest.79DEAAB57D31BFEF.quest_desc: [
		"Christmas windows come in &b13 designs&r and 18 colours, all from the Glassblower using matching stained glass."
		""
		"Place them next to each other and they &aconnect&r: picture walls go clear in the middle with a festive border, and patterns flow across the whole wall."
	]
	quest.79DEAAB57D31BFEF.title: "Stained Glass Windows"
	quest.7C0A15F3B1D2E402.quest_desc: [
		"Festivity has fallen below 50. Sour Elves, Nutcrackers and Coal Gnomes now drop &8Coal Tokens&r."
		""
		"Santy Claws keeps a list too. Prove you have been naughty and he pays in kind. Every reward here lowers Festivity for everyone, so the Nice players will not thank you."
	]
	quest.7C0A15F3B1D2E402.quest_subtitle: "Pick up your first Coal Token"
	quest.7C0A15F3B1D2E402.title: "The Naughty List"
	quest.7C0A15F3B1D2E405.quest_desc: ["Hand over 8 Coal Tokens. Santy Claws leaves you a wither skeleton skull and takes 2 Festivity from the world."]
	quest.7C0A15F3B1D2E405.quest_subtitle: "Coal for bone"
	quest.7C0A15F3B1D2E405.title: "A Lump of Coal"
	quest.7C0A15F3B1D2E409.quest_desc: ["16 Coal Tokens buy a Claws' Horn. Blow it (right-click) at night to call a Sour Elf pack to you. -3 Festivity for the world."]
	quest.7C0A15F3B1D2E409.quest_subtitle: "Call the pack"
	quest.7C0A15F3B1D2E409.title: "Santy's Horn"
	quest.7C0A15F3B1D2E40D.quest_desc: ["Do a Naughty Letter dare (Santy Claws sends them to one random player on quiet Merry days). The ledger remembers. Reward: a Netherite ingot, and the world loses 4 Festivity when you do it."]
	quest.7C0A15F3B1D2E40D.quest_subtitle: "Festivity scripts complete this one (checkmark task)"
	quest.7C0A15F3B1D2E40D.title: "Dear S. Claws"
	quest.7C0A15F3B1D2E502.quest_desc: [
		"Festivity is the world's shared Christmas spirit, 0 to 100. Festive food, decorations, gifts, growing colonies and helping each other raise it. Hurting villagers, breaking other people's decor and griefing lower it."
		""
		"Type &6/festivity&r to see the bar. &dRibbon Tokens&r come from driving off Santy Claws, freeing a kidnapped friend or smashing a Cursed Star."
	]
	quest.7C0A15F3B1D2E502.quest_subtitle: "Read me"
	quest.7C0A15F3B1D2E502.title: "The Nice List"
	quest.7C0A15F3B1D2E505.quest_desc: ["Eat any festive food while the bar is Merry or better (the Festivity scripts tick this off)."]
	quest.7C0A15F3B1D2E505.quest_subtitle: "A merry mouthful"
	quest.7C0A15F3B1D2E505.title: "Festive Feast"
	quest.7C0A15F3B1D2E508.quest_desc: ["Turn in 3 Ribbon Tokens. Santa sends a string of Fairy Lights and the world gains 2 Festivity."]
	quest.7C0A15F3B1D2E508.quest_subtitle: "Three ribbons"
	quest.7C0A15F3B1D2E508.title: "Tied With a Bow"
	quest.7C0A15F3B1D2E50C.quest_desc: ["Drive Santy Claws off yourself (be one of the players who hit him when he flees). The scripts tick this off and hand you his Horn."]
	quest.7C0A15F3B1D2E50C.quest_subtitle: "Scripts complete this one"
	quest.7C0A15F3B1D2E50C.title: "Not Tonight, Claws"
	quest.7C0A15F3B1D2E50F.quest_desc: ["Free a friend from a Giant Present by breaking the red knot on top. Scripts tick this off."]
	quest.7C0A15F3B1D2E50F.quest_subtitle: "Scripts complete this one"
	quest.7C0A15F3B1D2E50F.title: "Unwrapped"
	quest.7C2CA09A6F45BE6B.quest_desc: ["Horse-drawn travel for the whole group. Room for passengers and cargo."]
	quest.7C2CA09A6F45BE6B.title: "The Stagecoach"
	quest.7CB757564A9B681C.quest_desc: ["A common find in this dungeon's chests."]
	quest.7CB757564A9B681C.title: "Clinker Lantern"
	quest.7D0C998914EF6BB2.quest_desc: ["A very rare find in any dungeon."]
	quest.7D0C998914EF6BB2.title: "Elf Charm Pouch"
	quest.7D599F30B63C9769.quest_desc: [
		"Set the table: something savoury, something sweet, something warm to drink."
		"&7Then invite everyone over.&r"
	]
	quest.7D599F30B63C9769.title: "Christmas Dinner"
	quest.7EC3B9CB318C8A8A.quest_desc: ["Find wild onions and plant them."]
	quest.7EC3B9CB318C8A8A.title: "Onions"
	task.03DBAEFBC3800C57.title: "Santy Claws was driven off"
	task.07A8B1AC13BDF185.title: "I hosted a dinner for my friends"
	task.46D5C33595D8E442.title: "Let's go"
	task.4C1A0F15AFE70003.title: "I understand: fire spreads"
	task.57A28E1AD049FA3B.title: "I've donated"
	task.5F2B82AFEF0E0B30.title: "I showed my town to a friend"
	task.60046A666A27F184.title: "Built a snowy roof"
	task.6446FCD5E35EF8C3.title: "I'm being nice"
	task.648656B85BB6E0AC.title: "I found the Requests Board"
	chapter.34057A5E50000000.chapter_subtitle: ["How the pack works: keys, tools and the handy mods. Every quest here gives a little XP."]
	chapter.34057A5E50000000.title: "Start Here"
	chapter.34057A5E51000000.chapter_subtitle: ["The main story. Each step stays hidden until you finish the one before it."]
	chapter.34057A5E51000000.title: "The Long Winter"
	chapter.34057A5E52000000.chapter_subtitle: ["Everything about growing your MineColonies town: every hut, every level, the autopilot and the treasury."]
	chapter.34057A5E52000000.title: "Town Builder"
	chapter.34057A5E53000000.chapter_subtitle: ["Flour, dough, cookies, cakes and a gingerbread house. Use the recipe viewer for every recipe."]
	chapter.34057A5E53000000.title: "Christmas Baking"
	chapter.34057A5E54000000.chapter_subtitle: ["Hidden discoveries. Each one appears here the moment you find it."]
	chapter.34057A5E54000000.title: "Secrets Under the Snow"
	chapter.34057A5E55000000.chapter_subtitle: ["Bigger chests, better backpacks, pipes, and a full Refined Storage network."]
	chapter.34057A5E55000000.title: "Storage & Logistics"
	chapter.34057A5E56000000.chapter_subtitle: ["Power for your machines: from a starter generator to a reactor."]
	chapter.34057A5E56000000.title: "Powah!"
	chapter.34057A5E57000000.chapter_subtitle: ["Villagers with lives of their own, loyal dogs, horses and other animal friends."]
	chapter.34057A5E57000000.title: "Friends & Family"
	chapter.34057A5E58000000.chapter_subtitle: ["Better rods, hooks and bait, legendary fish, and a little ice fishing."]
	chapter.34057A5E58000000.title: "Fishing & the Sea"
	chapter.34057A5E59000000.chapter_subtitle: ["Accessories with real powers: artifacts, relics and jewelry."]
	chapter.34057A5E59000000.title: "Relics & Trinkets"
	quest.34057A5E50031F98.quest_desc: ["Via Romana lets you travel quickly along roads between places you have charted. The charting map shows them."]
	quest.34057A5E50031F98.title: "Charting the Roads"
	quest.34057A5E50097C56.quest_desc: [
		"[\"\",\"Open the big map with \",{\"keybind\":\"key.diorama.open_map\",\"color\":\"gold\"},\".\"]"
		"[\"\",\"Make a waypoint with \",{\"keybind\":\"key.diorama.new_waypoint\",\"color\":\"gold\"},\" and list them with \",{\"keybind\":\"key.diorama.waypoints\",\"color\":\"gold\"},\".\"]"
		"[\"\",\"Show or hide the minimap with \",{\"keybind\":\"key.diorama.toggle_minimap\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E50097C56.title: "Map and Waypoints"
	quest.34057A5E500C40BD.quest_desc: [
		"[\"\",\"The trash slot deletes junk: \",{\"keybind\":\"key.trashslot.toggle\",\"color\":\"gold\"},\" shows it.\"]"
		"[\"\",\"Crafting grid helpers: \",{\"keybind\":\"key.craftingtweaks.balance\",\"color\":\"gold\"},\" balances, \",{\"keybind\":\"key.craftingtweaks.clear\",\"color\":\"gold\"},\" clears.\"]"
	]
	quest.34057A5E500C40BD.title: "Tidy Inventory"
	quest.34057A5E502F7069.quest_desc: [
		"[\"\",\"Rings, necklaces, belts and charms go in the accessory slots. Open them with \",{\"keybind\":\"key.curios.open.desc\",\"color\":\"gold\"},\".\"]"
		"[\"\",\"Cosmetic armor slots let you wear a look over your real armor: \",{\"keybind\":\"cos.key.opencosarmorinventory\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E502F7069.title: "Trinket Slots"
	quest.34057A5E504FD079.quest_desc: [
		"[\"\",\"Hold \",{\"keybind\":\"key.ftbultimine\",\"color\":\"gold\"},\" while mining to break a whole vein of ore or a whole tree at once.\"]"
		"[\"\",\"Change the shape with \",{\"keybind\":\"ftbultimine.change_shape.next\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E504FD079.title: "Mine the Whole Vein"
	quest.34057A5E50608C5F.quest_desc: [
		"Holds several kinds of arrows."
		"[\"\",\"Pick which arrow to shoot with \",{\"keybind\":\"supplementaries.keybind.quiver\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E50608C5F.title: "A Quiver"
	quest.34057A5E5073623B.quest_desc: ["Pick a biome and the compass points to the nearest one."]
	quest.34057A5E5073623B.title: "Find a Biome"
	quest.34057A5E50815B49.quest_desc: ["Instruments play real songs. Play together with friends for a Christmas concert."]
	quest.34057A5E50815B49.title: "Make Some Music"
	quest.34057A5E508A5B1B.quest_desc: [
		"Cameras take real photos you can develop, frame and hang on the wall."
		"&7Load film, take the picture, then develop it in a Lightroom.&r"
	]
	quest.34057A5E508A5B1B.title: "Say Cheese"
	quest.34057A5E5099F180.quest_desc: [
		"Lots of mods start with no key set so nothing clashes."
		"[\"\",\"Open \",{\"keybind\":\"key.keybindatlas.open_keyboard\",\"color\":\"gold\"},\" (Keybind Atlas) to see every key, and click &fUnassigned&r to bind the ones you want.\"]"
		"&7The Chop's Christmas Handbook has a page per mod with its keys.&r"
	]
	quest.34057A5E5099F180.title: "Every Key on One Keyboard"
	quest.34057A5E50A4D6C4.quest_desc: ["Climb down holes and lower yourself into caves. Much safer than jumping."]
	quest.34057A5E50A4D6C4.title: "Rope"
	quest.34057A5E50B10980.quest_desc: [
		"The item list on the right side of your inventory shows every item in the pack."
		"[\"\",\"Hover an item and press \",{\"keybind\":\"key.jei.showRecipe\",\"color\":\"gold\"},\" to see how to make it.\"]"
		"[\"\",\"Press \",{\"keybind\":\"key.jei.showUses\",\"color\":\"gold\"},\" to see what it is used for.\"]"
		"[\"\",\"Press \",{\"keybind\":\"key.jei.bookmark\",\"color\":\"gold\"},\" to bookmark it for later.\"]"
	]
	quest.34057A5E50B10980.title: "Look It Up"
	quest.34057A5E50B2D55A.quest_desc: [
		"Seasons change over time and change which crops grow well."
		"A calendar tells you the season and how long until the next."
	]
	quest.34057A5E50B2D55A.title: "What Season Is It?"
	quest.34057A5E50B41AD8.quest_desc: [
		"Backpacks hold a lot and take upgrades."
		"[\"\",\"Wear it on your back, then open it with \",{\"keybind\":\"key.sophisticatedbackpacks.open_backpack\",\"color\":\"gold\"},\".\"]"
		"&7The Storage & Logistics chapter covers upgrades.&r"
	]
	quest.34057A5E50B41AD8.title: "A Bag for Everything"
	quest.34057A5E50BCB532.quest_desc: [
		"A construction stick places a whole row or wall of the block you point at, using blocks from your inventory."
		"Better sticks (iron, diamond, netherite) place more at once."
	]
	quest.34057A5E50BCB532.title: "Build Faster"
	quest.34057A5E50C05383.quest_desc: [
		"Welcome to &cChop's Christmas Special&r!"
		""
		"Quests are optional guides. Tick this one and the next ones open up."
		"[\"\",\"Open the quest book any time with \",{\"keybind\":\"key.ftbquests.quests\",\"color\":\"gold\"},\".\"]"
		"&7Chapters on the left: &fThe Long Winter&7 is the main story, &fChop's Christmas&7 is the festive side, and the rest are guides for each big mod.&r"
	]
	quest.34057A5E50C05383.quest_subtitle: "Read me first"
	quest.34057A5E50C05383.title: "Welcome, Friend!"
	quest.34057A5E50C40A26.quest_desc: [
		"A lasso picks up a friendly animal so you can carry it home."
		"Let it go by using the lasso on a block."
	]
	quest.34057A5E50C40A26.title: "Bring Them Home"
	quest.34057A5E50C6E6C8.quest_desc: [
		"A Megatorch stops hostile mobs from spawning naturally in a wide area around it."
		"&7Mobs from spawners and dungeons still come.&r"
	]
	quest.34057A5E50C6E6C8.title: "A Safe Base"
	quest.34057A5E50E474E9.quest_desc: ["Use it from your hand to open a crafting grid anywhere."]
	quest.34057A5E50E474E9.title: "A Crafting Table in Your Pocket"
	quest.34057A5E50E837C2.quest_desc: [
		"A sleeping bag lets you sleep through the night far from home. Great for trips."
		"&7Half the players asleep is enough to skip the night.&r"
	]
	quest.34057A5E50E837C2.title: "Sleep Anywhere"
	quest.34057A5E50EA68C2.quest_desc: [
		"The little box at the top of your screen names whatever block or mob you are looking at, and which mod it comes from."
		"[\"\",\"Toggle it with \",{\"keybind\":\"key.jade.show_overlay\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E50EA68C2.title: "What Am I Looking At?"
	quest.34057A5E50EC0F24.quest_desc: [
		"[\"\",\"Open the team menu with \",{\"keybind\":\"key.ftbteams.open_gui\",\"color\":\"gold\"},\" and invite your friends.\"]"
		"Quest progress is shared by the whole team, so you work through the book together."
	]
	quest.34057A5E50EC0F24.title: "Bring Your Friends"
	quest.34057A5E50F4F4FB.quest_desc: [
		"You started with &fChop's Christmas Handbook&r. It explains the pack, the Festivity meter and every mod's keys."
		"Lost it? Ask an op for another copy."
	]
	quest.34057A5E50F4F4FB.title: "The Handbook"
	quest.34057A5E50F7ECF0.quest_desc: [
		"Proximity voice chat is built in: people nearby hear you."
		"[\"\",\"Pick your microphone in \",{\"keybind\":\"key.voice_chat_settings\",\"color\":\"gold\"},\". Mute with \",{\"keybind\":\"key.mute_microphone\",\"color\":\"gold\"},\".\"]"
		"[\"\",\"Make a group call with \",{\"keybind\":\"key.voice_chat_group\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E50F7ECF0.title: "Talk to Each Other"
	quest.34057A5E50F9C41F.quest_desc: ["That's the basics. Head to &fThe Long Winter&r chapter for the main story, or &fChop's Christmas&r to start decorating."]
	quest.34057A5E50F9C41F.title: "Ready for Winter"
	quest.34057A5E50FA785C.quest_desc: [
		"Open Parties and Claims lets you claim chunks so nobody else can break or take things there."
		"Find its keys in Keybind Atlas (search &fparties&r), open the claims map and click chunks to claim them."
	]
	quest.34057A5E50FA785C.title: "Claim Your Land"
	quest.34057A5E50FE014F.quest_desc: ["Hang it between two posts. It lets you nap through the day instead of the night."]
	quest.34057A5E50FE014F.title: "A Hammock"
	quest.34057A5E51026026.quest_desc: ["Explore the Nether until you walk into a fortress. Blazes and wither skeletons live there."]
	quest.34057A5E51026026.title: "A Nether Fortress"
	quest.34057A5E510BAD83.quest_desc: [
		"The &aFestivity&r meter on your screen shows how merry the world is: Jolly, Merry, Quiet, Grumbling, Bleak... and worse."
		"Decorating, feasting, giving gifts and helping your town raise it. When it sinks too low, &4Claws&r comes calling."
		"&7The Chop's Christmas chapter is all about raising it.&r"
	]
	quest.34057A5E510BAD83.title: "Keep the World Jolly"
	quest.34057A5E5111DAA5.quest_desc: ["A rare dungeon find. Light it in your house and Claws cannot break in."]
	quest.34057A5E5111DAA5.title: "Candle of Vigil"
	quest.34057A5E511A2274.quest_desc: ["Punch a tree, make planks, make a crafting table."]
	quest.34057A5E511A2274.title: "Wood and a Workbench"
	quest.34057A5E511B1B4B.quest_desc: ["Coal Heart, Clinker Core, dragon's breath and four ender pearls. The needle points to Claws' Citadel in the End."]
	quest.34057A5E511B1B4B.title: "The Naughty Compass"
	quest.34057A5E511D6FFC.quest_desc: ["Throw one to see which way the stronghold lies."]
	quest.34057A5E511D6FFC.title: "Eyes of Ender"
	quest.34057A5E511F3AF5.quest_desc: ["Sleep through the night and set your spawn. Half of the players need to sleep to skip the night."]
	quest.34057A5E511F3AF5.title: "A Warm Bed"
	quest.34057A5E512BF608.quest_desc: ["Build a portal from obsidian, light it, and step through."]
	quest.34057A5E512BF608.title: "Through the Portal"
	quest.34057A5E512C29D0.quest_desc: ["Water puts out fires (there are a lot of candles in this pack). Lava fuels furnaces."]
	quest.34057A5E512C29D0.title: "Bucket"
	quest.34057A5E512C4CA1.quest_desc: ["This is where it ends. Bring everyone."]
	quest.34057A5E512C4CA1.title: "Santy Claws, Ascendant"
	quest.34057A5E512C7480.quest_desc: [
		"Write a letter to the real Santa and post it in a Christmas mailbox. He still reads them, even now."
		"&7Ask for something nice.&r"
	]
	quest.34057A5E512C7480.title: "Dear Santa"
	quest.34057A5E51325FC5.quest_desc: ["The Forgemaster's core still glows. With the Coal Heart, it can point the way to Claws himself."]
	quest.34057A5E51325FC5.title: "The Clinker Core"
	quest.34057A5E51359D97.quest_desc: ["Cook food, smelt ore, make glass. The &fKitchen & Farm&r chapter has bigger furnaces."]
	quest.34057A5E51359D97.title: "Smelting"
	quest.34057A5E51382C42.quest_desc: [
		"Coal Heart, blaze powder, a magma block and paper. Use it inside the Clinker Forge you already cleared to call the Forgemaster back for an encore."
		"&7Encore bosses drop extra loot. Using your Toymaker's Ticket in the Toymaster's beaten lair works the same way.&r"
	]
	quest.34057A5E51382C42.title: "Encore: Smoldering Summons"
	quest.34057A5E513C384C.quest_desc: ["Fire resistance and healing potions make the rest of the story much easier."]
	quest.34057A5E513C384C.title: "Brewing"
	quest.34057A5E513E2C8C.quest_desc: ["Paper, a compass and a lump of coal make a &6Toymaker's Ticket&r. Right-click it to read where the show is."]
	quest.34057A5E513E2C8C.title: "Admit One"
	quest.34057A5E513ED795.quest_desc: ["Bread, stew, roast anything. The &fKitchen & Farm&r and &fChristmas Baking&r chapters have hundreds more recipes."]
	quest.34057A5E513ED795.title: "Something Hot to Eat"
	quest.34057A5E5148E0BE.quest_desc: ["Winter is long here. A campfire cooks food and makes a cosy spot to come back to."]
	quest.34057A5E5148E0BE.title: "Keep Warm"
	quest.34057A5E514A2688.quest_desc: [
		"The Toymaster's grandest toy was never a weapon. It was a countdown."
		"Craft the &6Advent Calendar&r and hang it on a free wall 5 wide and 5 tall, somewhere the whole town will pass."
		"One door a day for everyone, and the big one on the 25th."
	]
	quest.34057A5E514A2688.title: "One Door a Day"
	quest.34057A5E5152933F.quest_desc: [
		"The Nether is where Claws grew from a hunger into a monster. His forges still burn there."
		"Light a portal and step through. Bring fire resistance if you can."
	]
	quest.34057A5E5152933F.quest_subtitle: "The Nether"
	quest.34057A5E5152933F.title: "Act V: The Burning Below"
	quest.34057A5E5155DFD0.quest_desc: [
		"With the Toymaster gone, his workshop secrets are loose. One of them is the &bForecast Globe&r."
		"Shake it to see where tonight is heading."
	]
	quest.34057A5E5155DFD0.title: "Tonight's Forecast"
	quest.34057A5E51586E36.quest_desc: ["Fill the portal frame with eyes and jump in."]
	quest.34057A5E51586E36.title: "The Edge of the World"
	quest.34057A5E51591E5E.quest_desc: ["Follow the eyes underground to the stronghold and its portal room."]
	quest.34057A5E51591E5E.title: "The Stronghold"
	quest.34057A5E515C9B33.quest_desc: ["Surround it with bookshelves for better enchantments."]
	quest.34057A5E515C9B33.title: "Enchanting"
	quest.34057A5E51623538.quest_desc: [
		"Claws' first captain waits in the Naughty Citadel. Bring friends."
		"When he falls, his &cNaughty/Nice Ledger&r falls with him. From then on, anyone in this world can craft one."
	]
	quest.34057A5E51623538.title: "The Twisted Toymaster"
	quest.34057A5E5166A5A4.quest_desc: [
		"The richest ores are deep underground. So are the &8coal gnomes&r, who swore themselves to Claws for a pocketful of coal."
		"&7Dig carefully. They hear the pickaxe long before they see you.&r"
	]
	quest.34057A5E5166A5A4.quest_subtitle: "Diamonds and magic"
	quest.34057A5E5166A5A4.title: "Act III: Deeper"
	quest.34057A5E516E1EB3.quest_desc: [
		"Claws was born in the End, out where the stars are cold. His Citadel waits there for him to come home."
		"To finish this, you have to go first."
	]
	quest.34057A5E516E1EB3.quest_subtitle: "The End"
	quest.34057A5E516E1EB3.title: "Act VI: The Frozen Star"
	quest.34057A5E517A7D2C.quest_desc: ["Find an End City ship and claim its elytra."]
	quest.34057A5E517A7D2C.title: "Wings"
	quest.34057A5E518C5BBE.quest_desc: ["Water on lava makes obsidian. You need ten for a portal."]
	quest.34057A5E518C5BBE.title: "Obsidian"
	quest.34057A5E51936704.quest_desc: ["Defeat the Ender Dragon. Bring friends, beds are not a good idea."]
	quest.34057A5E51936704.title: "Free the End"
	quest.34057A5E51958054.quest_desc: ["Block arrows and the odd thrown snowball."]
	quest.34057A5E51958054.title: "Hold the Line"
	quest.34057A5E51983A22.quest_desc: ["Mines obsidian."]
	quest.34057A5E51983A22.title: "Diamond Pickaxe"
	quest.34057A5E51A184F5.quest_desc: [
		"Santy Claws is beaten and the Heart of Winter is yours. The old stories said that if the world stayed jolly, Santa could finish him for good. You made sure it did."
		"The long winter can finally be a merry one. Go home, light the tree, and throw the biggest Christmas party the world has seen."
	]
	quest.34057A5E51A184F5.quest_subtitle: "Christmas is saved"
	quest.34057A5E51A184F5.title: "The Heart of Winter"
	quest.34057A5E51A69715.quest_desc: ["Blazes drop them. You need them for brewing and for Eyes of Ender."]
	quest.34057A5E51A69715.title: "Blaze Rods"
	quest.34057A5E51AC56B0.quest_desc: ["Look deep, below layer 0."]
	quest.34057A5E51AC56B0.title: "Diamonds!"
	quest.34057A5E51B51E5F.quest_desc: ["Claws doesn't come back. But a &bRemnant&r of him can: use this at his fallen throne for one more (weaker) fight and more loot."]
	quest.34057A5E51B51E5F.title: "Encore: Frozen Remnant"
	quest.34057A5E51BACAC4.quest_desc: ["Mines diamonds, gold and redstone."]
	quest.34057A5E51BACAC4.title: "Iron Pickaxe"
	quest.34057A5E51BB97D1.quest_desc: ["Optional and dangerous: summon and defeat the Wither for a nether star."]
	quest.34057A5E51BB97D1.title: "The Wither"
	quest.34057A5E51BDF2B5.quest_desc: [
		"You survived the first nights. Now make a proper start: iron gear and a place to call home."
		"&7Claws hates a happy town. That's a very good reason to build one.&r"
	]
	quest.34057A5E51BDF2B5.quest_subtitle: "Iron, armor and a town"
	quest.34057A5E51BDF2B5.title: "Act II: Settle Down"
	quest.34057A5E51BF3261.quest_desc: [
		"Every great Christmas village starts with a Town Hall. Place one (see &fColony Life&r) and your colonists will build the rest."
		"&7Town Builder is the full guide.&r"
	]
	quest.34057A5E51BF3261.title: "Found a Town"
	quest.34057A5E51C05EFB.quest_desc: ["Coal Heart + blaze powder + compass makes a &6Forge Ember&r. It only burns in the &cNether&r, where its trail leads to the Clinker Forge."]
	quest.34057A5E51C05EFB.title: "Follow the Ember"
	quest.34057A5E51C46803.quest_desc: [
		"Claws corrupted Santa's elves into &cSour Elves&r and set the &6Toymaster&r to building an army of nutcrackers."
		"His servants have built strongholds all over the world: toy factories, prison mines, labyrinths, frozen stables."
		"Each dungeon chapter on the left tells you what to look for. They are rare, so explore: by boat, by sled, by stagecoach."
	]
	quest.34057A5E51C46803.quest_subtitle: "The Naughty side of the North Pole"
	quest.34057A5E51C46803.title: "Act IV: Christmas Gone Wrong"
	quest.34057A5E51CC9891.quest_desc: [
		"Nutcrackers, coal gnomes and sour elves only live in Claws' dungeons and hideouts."
		"Find a dungeon and defeat one of each."
	]
	quest.34057A5E51CC9891.title: "Know Your Enemy"
	quest.34057A5E51CF97E9.quest_desc: [
		"Find and clear any of Claws' dungeons. Look in the dungeon chapters for hints on where each one hides."
		"&7Dungeons hold loot found nowhere else. Common finds are in chests, rare ones in vaults.&r"
	]
	quest.34057A5E51CF97E9.title: "Into the Dungeon"
	quest.34057A5E51D94714.quest_desc: [
		"Long ago, something hungry crawled out of the End. It learned to wear a red coat and a white beard, and it called itself &4Santy Claws&r."
		"It wants every Christmas to be its Christmas. Now the elves have turned sour, the toys have turned mean, and a long winter has fallen over the world."
		""
		"First things first: stay warm and stay fed."
	]
	quest.34057A5E51D94714.quest_subtitle: "Survive the first night"
	quest.34057A5E51D94714.title: "Act I: The Cold"
	quest.34057A5E51DC92C6.quest_desc: ["The Toymaster's heart is a lump of burning coal. Keep it: it leads the way to the next of Claws' captains."]
	quest.34057A5E51DC92C6.title: "The Coal Heart"
	quest.34057A5E51E0E25B.quest_desc: ["Smelt raw iron in a furnace."]
	quest.34057A5E51E0E25B.title: "Iron!"
	quest.34057A5E51E22DF9.quest_desc: ["Iron armor. The things in the dungeons hit hard."]
	quest.34057A5E51E22DF9.title: "Suit Up"
	quest.34057A5E51E431FF.quest_desc: ["Claws' second captain works the Clinker Forge. It is very hot in there."]
	quest.34057A5E51E431FF.title: "The Clinker Forgemaster"
	quest.34057A5E51FE46D9.quest_desc: ["Stone tools last longer and mine iron."]
	quest.34057A5E51FE46D9.title: "Stone Age"
	quest.34057A5E52005C65.quest_desc: ["A small town!"]
	quest.34057A5E52005C65.title: "50 Citizens"
	quest.34057A5E52008507.quest_desc: ["Nearly a city."]
	quest.34057A5E52008507.title: "Town Hall IV"
	quest.34057A5E5204F7D7.quest_desc: ["Sends a brave citizen through a portal to bring back Nether goods. Craft the hut block and place it."]
	quest.34057A5E5204F7D7.title: "The Nether Worker"
	quest.34057A5E5205A54B.quest_desc: ["Citizens study here to raise their skills."]
	quest.34057A5E5205A54B.title: "Library III"
	quest.34057A5E520F42DB.quest_desc: ["A better fisher brings home more (and sometimes treasure)."]
	quest.34057A5E520F42DB.title: "Fisher III"
	quest.34057A5E520FDED7.quest_desc: [
		"Town Hall V, fifty citizens, a master builder, a great warehouse and a town that's fed, armed and clever."
		"Light it all up and invite everyone over. Merry Christmas, mayor!"
	]
	quest.34057A5E520FDED7.quest_subtitle: "The finest town in the north"
	quest.34057A5E520FDED7.title: "A Christmas Wonderland"
	quest.34057A5E52126CC4.quest_desc: ["A postbox lets you order things from the warehouse. A stash sends things to it."]
	quest.34057A5E52126CC4.title: "Post and Stash"
	quest.34057A5E5214B0EF.quest_desc: ["Glass and panes for all those windows. Craft the hut block and place it."]
	quest.34057A5E5214B0EF.title: "The Glassblower"
	quest.34057A5E5217884D.quest_desc: ["Upgrade the Town Hall. More huts unlock as it grows."]
	quest.34057A5E5217884D.title: "Town Hall II"
	quest.34057A5E52194E09.quest_desc: ["The pack has its own &cChop's Christmas Village&r building style. Pick it in the build tool when you place your first hut and the whole town matches."]
	quest.34057A5E52194E09.title: "The Christmas Village Style"
	quest.34057A5E521C0180.quest_desc: ["The biggest Town Hall there is."]
	quest.34057A5E521C0180.title: "Town Hall V"
	quest.34057A5E522001A2.quest_desc: ["Forty citizens."]
	quest.34057A5E522001A2.title: "40 Citizens"
	quest.34057A5E522CE65B.quest_desc: ["Give a farmer as many fields as it can handle."]
	quest.34057A5E522CE65B.title: "Fields Everywhere"
	quest.34057A5E522E922F.quest_desc: ["The barracks and its towers hold many guards at once."]
	quest.34057A5E522E922F.title: "The Barracks"
	quest.34057A5E522F579D.quest_desc: ["More travelers stop by, and some of them stay."]
	quest.34057A5E522F579D.title: "Tavern III"
	quest.34057A5E52327F27.quest_desc: [
		"Your colony buys what it can't make itself with &6ColonyBucks&r: building materials, guard gear, research, cures."
		"You find bucks in dungeon and structure chests, and the colony earns some from kills and raids."
		"Sneak-right-click the Town Hall with bucks in hand to pay them in."
	]
	quest.34057A5E52327F27.title: "ColonyBucks"
	quest.34057A5E52365E38.quest_desc: ["A citizen comes back to life at the graveyard."]
	quest.34057A5E52365E38.title: "Back From the Grave"
	quest.34057A5E523792AE.quest_desc: ["Sifts gravel and sand for ores and other goodies."]
	quest.34057A5E523792AE.title: "The Sifter"
	quest.34057A5E523BDD0A.quest_desc: ["A proper town now."]
	quest.34057A5E523BDD0A.title: "Town Hall III"
	quest.34057A5E523CBB1D.quest_desc: ["Whole forests, replanted as fast as they fall."]
	quest.34057A5E523CBB1D.title: "Forester V"
	quest.34057A5E523D0324.quest_desc: ["Twenty people and counting."]
	quest.34057A5E523D0324.title: "20 Citizens"
	quest.34057A5E5242B52B.quest_desc: ["A level 5 house. Someone's living well."]
	quest.34057A5E5242B52B.title: "Grand Homes"
	quest.34057A5E524438D1.quest_desc: ["Turns citizens' experience into enchanted books."]
	quest.34057A5E524438D1.title: "The Enchanter"
	quest.34057A5E52490700.quest_desc: ["The undertaker earns a totem. Sometimes the dead come back."]
	quest.34057A5E52490700.title: "Undertaker's Totem"
	quest.34057A5E524B9F4C.quest_desc: ["Redstone parts, rails and gadgets."]
	quest.34057A5E524B9F4C.title: "The Mechanic"
	quest.34057A5E524FCCA0.quest_desc: ["Thirty guards. Nobody is getting in."]
	quest.34057A5E524FCCA0.title: "The Town Watch"
	quest.34057A5E5250F611.quest_desc: ["When a ravine or river cuts through town, builders can span it with a bridge deck."]
	quest.34057A5E5250F611.title: "Mind the Gap"
	quest.34057A5E525238B4.quest_desc: [
		"Short on bucks? The Town Hall's &fExchange&r tab buys diamonds, gold, ancient debris and netherite for ColonyBucks."
		"&7Or run /colonyautopilot exchange while standing in your colony. It only buys; bucks never come back out.&r"
	]
	quest.34057A5E525238B4.title: "The Exchange"
	quest.34057A5E5258DEB7.quest_desc: ["A bigger restaurant feeds more people faster."]
	quest.34057A5E5258DEB7.title: "Restaurant III"
	quest.34057A5E52602968.quest_desc: ["Pork for the Christmas ham."]
	quest.34057A5E52602968.title: "The Swineherd"
	quest.34057A5E526091DA.quest_desc: ["Fifteen. The town might start thinking about a wall."]
	quest.34057A5E526091DA.title: "15 Citizens"
	quest.34057A5E526478FC.quest_desc: ["Digs deeper levels of the mine."]
	quest.34057A5E526478FC.title: "Miner III"
	quest.34057A5E526CE086.quest_desc: ["Diamond gear for the guards."]
	quest.34057A5E526CE086.title: "Blacksmith V"
	quest.34057A5E52721B10.quest_desc: ["A hundred people. Santa would be proud."]
	quest.34057A5E52721B10.title: "100 Citizens"
	quest.34057A5E5275BC51.quest_desc: ["Milk and beef."]
	quest.34057A5E5275BC51.title: "The Cowhand"
	quest.34057A5E52771508.quest_desc: ["The whole town is learning."]
	quest.34057A5E52771508.title: "Library V"
	quest.34057A5E52785988.quest_desc: ["The tallest watchtower."]
	quest.34057A5E52785988.title: "Guard Tower V"
	quest.34057A5E527AEA66.quest_desc: ["Level 5 is the top for every hut. These are the long-haul goals."]
	quest.34057A5E527AEA66.title: "Mastery"
	quest.34057A5E527AFA07.quest_desc: ["Level 5 can sort and hold almost everything the town owns."]
	quest.34057A5E527AFA07.title: "The Great Warehouse"
	quest.34057A5E527D6C20.quest_desc: ["More fields, more crops."]
	quest.34057A5E527D6C20.title: "Farmer III"
	quest.34057A5E527EBC90.quest_desc: ["Now that's a Christmas town."]
	quest.34057A5E527EBC90.title: "75 Citizens"
	quest.34057A5E52830FF8.quest_desc: ["Ten citizens. Travelers at the tavern can be hired too."]
	quest.34057A5E52830FF8.title: "10 Citizens"
	quest.34057A5E52850ADA.quest_desc: ["Stone bricks, stairs and walls."]
	quest.34057A5E52850ADA.title: "The Stonemason"
	quest.34057A5E5286D6F2.quest_desc: ["Trains knights."]
	quest.34057A5E5286D6F2.title: "The Combat Academy"
	quest.34057A5E5288AEE5.quest_desc: ["Places blueprints for huts and decorations. Pick a style, rotate, and confirm."]
	quest.34057A5E5288AEE5.title: "The Build Tool"
	quest.34057A5E528BE4AF.quest_desc: ["The best farm in the north."]
	quest.34057A5E528BE4AF.title: "Farmer V"
	quest.34057A5E528FEED4.quest_desc: ["Once the town is big enough it raises a wall. The gatehouse is its front door."]
	quest.34057A5E528FEED4.title: "The Gatehouse"
	quest.34057A5E52904074.quest_desc: ["Your miner reaches the deep levels."]
	quest.34057A5E52904074.title: "Deep Mine"
	quest.34057A5E5290F271.quest_desc: ["Trains ranged guards."]
	quest.34057A5E5290F271.title: "The Archery"
	quest.34057A5E5293BF28.quest_desc: ["Hungry citizens are unhappy citizens. These huts keep the pantry full."]
	quest.34057A5E5293BF28.title: "Feeding the Town"
	quest.34057A5E529660F1.quest_desc: ["Five people call your town home. Build houses to make room for more."]
	quest.34057A5E529660F1.title: "5 Citizens"
	quest.34057A5E5296C388.quest_desc: ["Your builder finishes the Town Hall."]
	quest.34057A5E5296C388.title: "Town Hall I"
	quest.34057A5E52980560.quest_desc: ["Each barracks tower adds more guards."]
	quest.34057A5E52980560.title: "Barracks Tower"
	quest.34057A5E529C801E.quest_desc: [
		"/colonyautopilot treasury shows the balance, what the town is waiting to pay for, and today's income and spending."
		"If builds seem stuck, /colonyautopilot problems lists anything that needs a human."
	]
	quest.34057A5E529C801E.title: "Check the Books"
	quest.34057A5E529DB77A.quest_desc: ["A level 5 builder can build anything."]
	quest.34057A5E529DB77A.title: "Grand Architect"
	quest.34057A5E529DCE50.quest_desc: ["Bows, arrows and string for the guards."]
	quest.34057A5E529DCE50.title: "The Fletcher"
	quest.34057A5E52A12ADA.quest_desc: ["The deepest mine levels."]
	quest.34057A5E52A12ADA.title: "Miner V"
	quest.34057A5E52A13F88.quest_desc: ["Eggs and feathers."]
	quest.34057A5E52A13F88.title: "The Chicken Herder"
	quest.34057A5E52A3C8D7.quest_desc: ["Builders need a lot of stuff. These huts make it so you don't have to."]
	quest.34057A5E52A3C8D7.title: "Materials and Industry"
	quest.34057A5E52A52AE7.quest_desc: ["A busy village."]
	quest.34057A5E52A52AE7.title: "25 Citizens"
	quest.34057A5E52A887EC.quest_desc: ["Better guards with better gear."]
	quest.34057A5E52A887EC.title: "Guard Tower III"
	quest.34057A5E52AB9100.quest_desc: ["More wood, faster."]
	quest.34057A5E52AB9100.title: "Forester III"
	quest.34057A5E52ACFA60.quest_desc: ["Smeltery level 3."]
	quest.34057A5E52ACFA60.title: "Hot Work"
	quest.34057A5E52AE88AD.quest_desc: ["Smooth stone, glass and bricks."]
