	quest.34057A5E5477F3DB.quest_desc: [
		"This chapter starts empty on purpose. You do not need to tick this quest first: discoveries count any time."
		"The world is full of dungeons, ruins and lost places. Walk into one and its quest appears here, already finished, with a reward."
		"&7No maps, no hints. Just explore.&r"
	]
	quest.34057A5E5477F3DB.title: "Secrets Under the Snow"
	quest.34057A5E54820903.quest_desc: ["Shulkers, purpur and maybe a ship with wings in it."]
	quest.34057A5E54820903.title: "End City"
	quest.34057A5E548D47E1.quest_desc: ["A valley from before the world was finished, now under snow."]
	quest.34057A5E548D47E1.title: "Wintry Origin Valley"
	quest.34057A5E548D4EEC.quest_desc: ["Very quiet. Stay that way."]
	quest.34057A5E548D4EEC.title: "Ancient City"
	quest.34057A5E54933E64.quest_desc: ["A gingerbread house in the woods. Don't nibble the walls."]
	quest.34057A5E54933E64.title: "The Other Gingerbread House"
	quest.34057A5E5498D27D.quest_desc: ["Smoke from the chimney. Somebody's home."]
	quest.34057A5E5498D27D.title: "The Winter Witch's House"
	quest.34057A5E54995A95.quest_desc: ["Smells like fresh bread."]
	quest.34057A5E54995A95.title: "A Village Bakery"
	quest.34057A5E549BF121.quest_desc: ["These are the raiders who visit towns. Now you know where they live."]
	quest.34057A5E549BF121.title: "Barbarian Camp"
	quest.34057A5E549D0BFA.quest_desc: ["Old rails and cobwebs. Watch for cave spiders."]
	quest.34057A5E549D0BFA.title: "Abandoned Mineshaft"
	quest.34057A5E549E6379.quest_desc: ["A frost hound, beaten."]
	quest.34057A5E549E6379.title: "Down, Boy"
	quest.34057A5E54AA6D84.quest_desc: ["A whole ship, lost at sea."]
	quest.34057A5E54AA6D84.title: "A Lost Galleon"
	quest.34057A5E54AB29F7.quest_desc: ["The old fish is gone. You can mine in peace."]
	quest.34057A5E54AB29F7.title: "Elder Guardian"
	quest.34057A5E54B8E995.quest_desc: ["Pillagers. Not on the Nice List."]
	quest.34057A5E54B8E995.title: "Pillager Outpost"
	quest.34057A5E54BBD2A0.quest_desc: ["A ship speared by a mountain of ice."]
	quest.34057A5E54BBD2A0.title: "The Impaled Icebreaker"
	quest.34057A5E54C27BF9.quest_desc: ["A cave decorated for Christmas, deep underground. Who decorated it?"]
	quest.34057A5E54C27BF9.title: "The Glittering Cave"
	quest.34057A5E54C9FAAC.quest_desc: ["Tripwires and arrows. Classic."]
	quest.34057A5E54C9FAAC.title: "Jungle Temple"
	quest.34057A5E54CC1D82.quest_desc: ["You drove off Santy Claws himself. For now."]
	quest.34057A5E54CC1D82.title: "Not Tonight, Claws"
	quest.34057A5E54D5652A.quest_desc: ["A lonely farmhouse on the prairie."]
	quest.34057A5E54D5652A.title: "A Prairie House"
	quest.34057A5E54D779D2.quest_desc: ["Webs, frost and a lot of legs."]
	quest.34057A5E54D779D2.title: "Ice Spider Den"
	quest.34057A5E54E1A8E4.quest_desc: ["You beat the Warden. Most people just run."]
	quest.34057A5E54E1A8E4.title: "Shhh"
	quest.34057A5E54EC64FC.quest_desc: ["Deep in the dark, Claws' servants listen. For what?"]
	quest.34057A5E54EC64FC.title: "Claws' Listening Post"
	quest.34057A5E54F0C82B.quest_desc: ["Stone ruins under the cold sea."]
	quest.34057A5E54F0C82B.title: "Cold Ocean Ruins"
	quest.34057A5E54F2183A.quest_desc: ["Even after the end, something of Claws lingered. Not any more."]
	quest.34057A5E54F2183A.title: "What Remains"
	quest.34057A5E54F72D1C.quest_desc: ["A warm, green cave in a frozen world."]
	quest.34057A5E54F72D1C.title: "Lush Caves"
	quest.34057A5E54FEDE9C.quest_desc: ["The highest, coldest peaks."]
	quest.34057A5E54FEDE9C.title: "Top of the World"
	quest.34057A5E550BEE3D.quest_desc: ["Pulls items from a chest or machine into the network."]
	quest.34057A5E550BEE3D.title: "Importer"
	quest.34057A5E550CF67E.quest_desc: ["Keep it anywhere in your inventory: Festivity drops near you tumble in on their own."]
	quest.34057A5E550CF67E.title: "Santa's Sack"
	quest.34057A5E5510027E.quest_desc: ["Shows a normal chest's contents in the grid."]
	quest.34057A5E5510027E.title: "External Storage"
	quest.34057A5E55174F70.quest_desc: ["The metal most Refined Storage parts are made of."]
	quest.34057A5E55174F70.title: "Quartz Enriched Iron"
	quest.34057A5E55218131.quest_desc: ["Even more slots."]
	quest.34057A5E55218131.title: "Diamond Chest"
	quest.34057A5E5527F63D.quest_desc: ["The screen where you see and take everything in the network."]
	quest.34057A5E5527F63D.title: "The Grid"
	quest.34057A5E552AE8F3.quest_desc: ["Pipes move items between inventories. Use the wrench to set which side pulls."]
	quest.34057A5E552AE8F3.title: "Item Pipes"
	quest.34057A5E552D5AC9.quest_desc: ["Items you walk over go straight into the backpack."]
	quest.34057A5E552D5AC9.title: "Pickup Upgrade"
	quest.34057A5E5544367C.quest_desc: ["The fastest pipes there are."]
	quest.34057A5E5544367C.title: "Ultimate Upgrade"
	quest.34057A5E55447C29.quest_desc: ["Smelt quartz to get silicon."]
	quest.34057A5E55447C29.title: "Silicon"
	quest.34057A5E554968D1.quest_desc: ["Keeps your hotbar topped up from the backpack (torches, food, blocks)."]
	quest.34057A5E554968D1.title: "Refill Upgrade"
	quest.34057A5E55550748.quest_desc: ["Pulls nearby items toward you."]
	quest.34057A5E55550748.title: "Magnet Upgrade"
	quest.34057A5E5557E175.quest_desc: ["Upgrade a chest's tier with a tier upgrade item; check the recipe viewer."]
	quest.34057A5E5557E175.title: "Iron Chest"
	quest.34057A5E5562B279.quest_desc: ["Raw processors get smelted into working ones."]
	quest.34057A5E5562B279.title: "Processors"
	quest.34057A5E5564F267.quest_desc: ["Christmas means presents, and presents mean stuff. This chapter goes from a better chest to a whole storage computer."]
	quest.34057A5E5564F267.title: "Where Do I Put It All?"
	quest.34057A5E55699B6A.quest_desc: ["Holds storage disks."]
	quest.34057A5E55699B6A.title: "Disk Drive"
	quest.34057A5E557351D9.quest_desc: ["A pattern remembers a recipe so the network can craft it on request."]
	quest.34057A5E557351D9.title: "Patterns"
	quest.34057A5E5573A4A9.quest_desc: ["More slots."]
	quest.34057A5E5573A4A9.title: "Gold Chest"
	quest.34057A5E557DB106.quest_desc: ["The last backpack tier. Doesn't burn in lava."]
	quest.34057A5E557DB106.title: "Netherite Backpack"
	quest.34057A5E55859078.quest_desc: ["Sixty-four thousand items per disk."]
	quest.34057A5E55859078.title: "Huge Disks"
	quest.34057A5E558C0761.quest_desc: ["Sophisticated chests and barrels can be upgraded in place without emptying them."]
	quest.34057A5E558C0761.title: "A Better Chest"
	quest.34057A5E55922BC9.quest_desc: ["The starting part for chest upgrades: stack, pickup, smelting, compacting, void and more."]
	quest.34057A5E55922BC9.title: "Upgrade Base"
	quest.34057A5E55947EB9.quest_desc: ["Same idea, for water, lava and other fluids."]
	quest.34057A5E55947EB9.title: "Fluid Pipes"
	quest.34057A5E559604FB.quest_desc: ["Pushes chosen items out of the network into a chest or machine."]
	quest.34057A5E559604FB.title: "Exporter"
	quest.34057A5E559BD126.quest_desc: ["Link chests and barrels next to it so they act like one big storage. Add storage links to reach further."]
	quest.34057A5E559BD126.title: "Storage Controller"
	quest.34057A5E55A553B3.quest_desc: ["Bigger again."]
	quest.34057A5E55A553B3.title: "Gold Backpack"
	quest.34057A5E55A8712A.quest_desc: ["Connects every part of the network to the controller."]
	quest.34057A5E55A8712A.title: "Cable"
	quest.34057A5E55AAD470.quest_desc: ["Your whole storage in your pocket, near a wireless transmitter."]
	quest.34057A5E55AAD470.title: "Wireless Grid"
	quest.34057A5E55AD0B86.quest_desc: ["Holds processors together."]
	quest.34057A5E55AD0B86.title: "Processor Binding"
	quest.34057A5E55AF7279.quest_desc: ["Wear it, open it with a key, and keep adding upgrades."]
	quest.34057A5E55AF7279.title: "Backpack"
	quest.34057A5E55B70D1F.quest_desc: ["Everything you own, in one place, on demand. The elves would be jealous."]
	quest.34057A5E55B70D1F.title: "Santa's Workshop Inventory"
	quest.34057A5E55B8ED83.quest_desc: ["Upgrades make pipes faster and let you filter what goes through."]
	quest.34057A5E55B8ED83.title: "Basic Pipe Upgrade"
	quest.34057A5E55BC2861.quest_desc: ["Huge."]
	quest.34057A5E55BC2861.title: "Diamond Backpack"
	quest.34057A5E55BC80B2.quest_desc: ["Sixteen thousand items per disk."]
	quest.34057A5E55BC80B2.title: "Bigger Disks"
	quest.34057A5E55CC6441.quest_desc: ["Bigger, with more upgrade slots."]
	quest.34057A5E55CC6441.title: "Iron Backpack"
	quest.34057A5E55D32DEC.quest_desc: ["The biggest chest there is."]
	quest.34057A5E55D32DEC.title: "Netherite Chest"
	quest.34057A5E55D40243.quest_desc: ["The frame for every machine."]
	quest.34057A5E55D40243.title: "Machine Casing"
	quest.34057A5E55D4DD50.quest_desc: ["A grid with a crafting table built in, pulling ingredients straight from storage."]
	quest.34057A5E55D4DD50.title: "Crafting Grid"
	quest.34057A5E55D774E6.quest_desc: ["Turns nuggets into ingots and ingots into blocks automatically."]
	quest.34057A5E55D774E6.title: "Compacting Upgrade"
	quest.34057A5E55DFF4E4.quest_desc: ["Gives the network a wireless range for wireless grids."]
	quest.34057A5E55DFF4E4.title: "Wireless Transmitter"
	quest.34057A5E55E6D9CA.quest_desc: ["A crafting grid inside your backpack."]
	quest.34057A5E55E6D9CA.title: "Crafting Upgrade"
	quest.34057A5E55ED4FCA.quest_desc: ["Packing tape lets you pick up a full chest without spilling it."]
	quest.34057A5E55ED4FCA.title: "Moving Day"
	quest.34057A5E55F078BF.quest_desc: ["A 1k disk holds a thousand items. Bigger disks come later."]
	quest.34057A5E55F078BF.title: "Your First Disk"
	quest.34057A5E55F12468.quest_desc: ["Right-click a pipe end to turn extracting on or off."]
	quest.34057A5E55F12468.title: "Pipe Wrench"
	quest.34057A5E55F42DB8.quest_desc: ["The heart of the network. It needs power (Powah works) to run."]
	quest.34057A5E55F42DB8.title: "The Controller"
	quest.34057A5E55FD0782.quest_desc: ["Put patterns in it and ask the grid for something. It crafts it for you."]
	quest.34057A5E55FD0782.title: "Autocrafter"
	quest.34057A5E55FEBEEE.quest_desc: [
		"A storage computer: every item in one searchable screen."
		"This is a bigger project. Work through it step by step."
	]
	quest.34057A5E55FEBEEE.title: "Refined Storage"
	quest.34057A5E56152479.quest_desc: ["Energize four blaze powder (or a blaze rod). Needed for blazing tier parts."]
	quest.34057A5E56152479.title: "Blazing Crystal"
	quest.34057A5E5619BBE6.quest_desc: ["Powah makes energy (FE) and stores it. Refined Storage and other machines run on it."]
	quest.34057A5E5619BBE6.title: "Power Up"
	quest.34057A5E561AE1CA.quest_desc: ["Burns lava (and other hot fluids) for power."]
	quest.34057A5E561AE1CA.title: "Magmator"
	quest.34057A5E561DC5E5.quest_desc: ["Charges the items in your inventory wirelessly."]
	quest.34057A5E561DC5E5.title: "Player Transmitter"
	quest.34057A5E561FB6CB.quest_desc: ["The sticky stuff in most Powah parts."]
	quest.34057A5E561FB6CB.title: "Dielectric Paste"
	quest.34057A5E562086BC.quest_desc: ["Put items in the orb, surround it with energizing rods and give the rods power. It fuses them into new materials."]
	quest.34057A5E562086BC.title: "Energizing Orb"
	quest.34057A5E56406031.quest_desc: ["Energize a diamond."]
	quest.34057A5E56406031.title: "Niotic Crystal"
	quest.34057A5E56541AB5.quest_desc: ["Burns fuel like coal to make power. The easiest first generator."]
	quest.34057A5E56541AB5.title: "Starter Furnator"
	quest.34057A5E565BECBD.quest_desc: ["The biggest battery in the pack."]
	quest.34057A5E565BECBD.title: "Nitro Energy Cell"
	quest.34057A5E565EF456.quest_desc: ["Makes power from heat sources underneath it, cooled with water."]
	quest.34057A5E565EF456.title: "Thermo Generator"
	quest.34057A5E5689440D.quest_desc: ["Energize a snowball. Throw it at something. Very Christmas."]
	quest.34057A5E5689440D.title: "Charged Snowball"
	quest.34057A5E569721EB.quest_desc: ["Carries power to your machines."]
	quest.34057A5E569721EB.title: "Energy Cable"
	quest.34057A5E5698108B.quest_desc: ["An iron ingot and a gold ingot, energized together in the orb."]
	quest.34057A5E5698108B.title: "Energized Steel"
	quest.34057A5E569D84FB.quest_desc: ["Place rods within a few blocks of the orb and power them."]
	quest.34057A5E569D84FB.title: "Energizing Rods"
	quest.34057A5E56C21D85.quest_desc: ["Reactor blocks build into one big multiblock reactor; the recipe viewer and the Powah book show how. Feed it uraninite and keep it cool."]
	quest.34057A5E56C21D85.title: "A Reactor"
	quest.34057A5E56CE6F59.quest_desc: ["A nether star, two redstone blocks and a blazing crystal block. The top tier."]
	quest.34057A5E56CE6F59.title: "Nitro Crystal"
	quest.34057A5E56CEF71D.quest_desc: ["The next tier of furnator: more power from the same fuel."]
	quest.34057A5E56CEF71D.title: "Basic Furnator"
	quest.34057A5E56D563B4.quest_desc: ["A bigger battery."]
	quest.34057A5E56D563B4.title: "Basic Energy Cell"
	quest.34057A5E56D77355.quest_desc: ["Faster rods make the orb work faster."]
	quest.34057A5E56D77355.title: "Basic Energizing Rod"
	quest.34057A5E56DA0D35.quest_desc: ["Free power while the sun is up."]
	quest.34057A5E56DA0D35.title: "Solar Panel"
	quest.34057A5E56DE868F.quest_desc: ["Energize an emerald."]
	quest.34057A5E56DE868F.title: "Spirited Crystal"
	quest.34057A5E56E7824C.quest_desc: ["Mine uraninite ore and energize it (or smelt the raw ore). Reactors burn it."]
	quest.34057A5E56E7824C.title: "Uraninite"
	quest.34057A5E56EF4DC2.quest_desc: ["Stores power for later."]
	quest.34057A5E56EF4DC2.title: "Energy Cell"
	quest.34057A5E57013119.quest_desc: ["Dogs eat from their bowl while you are away."]
	quest.34057A5E57013119.title: "Food Bowl"
	quest.34057A5E571C6AA1.quest_desc: ["Hand a pet over to a friend, properly."]
	quest.34057A5E571C6AA1.title: "Deed of Ownership"
	quest.34057A5E5725A5EC.quest_desc: ["Find a penguin. They live where it's coldest."]
	quest.34057A5E5725A5EC.title: "Penguins!"
	quest.34057A5E572830EC.quest_desc: ["Keep animals in a pen block instead of a big field."]
	quest.34057A5E572830EC.title: "Animal Pen"
	quest.34057A5E5737AA82.quest_desc: ["Pull it behind a horse to till whole fields at once."]
	quest.34057A5E5737AA82.title: "A Plow"
	quest.34057A5E57384754.quest_desc: ["Call your dogs, tell them to stay, or send them to attack."]
	quest.34057A5E57384754.title: "Whistle"
	quest.34057A5E573FB6F7.quest_desc: ["Then get married."]
	quest.34057A5E573FB6F7.title: "Wedding Ring"
	quest.34057A5E576111DC.quest_desc: ["The final level. A very good dog."]
	quest.34057A5E576111DC.title: "Master Treat"
	quest.34057A5E576E21A8.quest_desc: ["When they like you enough, propose."]
	quest.34057A5E576E21A8.title: "Engagement Ring"
	quest.34057A5E577D4EF0.quest_desc: ["Polar bears can be ridden in this pack."]
	quest.34057A5E577D4EF0.title: "Ride a Polar Bear"
	quest.34057A5E578554C9.quest_desc: ["Fluffy white seals live on cold beaches and ice."]
	quest.34057A5E578554C9.title: "Harp Seals"
	quest.34057A5E579653CC.quest_desc: ["Hitch a cart to a horse to carry loads of stuff."]
	quest.34057A5E579653CC.title: "A Supply Cart"
	quest.34057A5E57A04EA8.quest_desc: ["Dogs sleep in their bed and come back to it."]
	quest.34057A5E57A04EA8.title: "A Dog Bed"
	quest.34057A5E57A1B09B.quest_desc: ["A rare find in the Frozen Reindeer Stables."]
	quest.34057A5E57A1B09B.title: "A Reindeer of Your Own"
	quest.34057A5E57AED816.quest_desc: ["Look along cold coasts and kelp forests."]
	quest.34057A5E57AED816.title: "Sea Otters"
	quest.34057A5E57B07B8B.quest_desc: ["The unicorns of the frozen sea."]
	quest.34057A5E57B07B8B.title: "Narwhals"
	quest.34057A5E57B9FAA1.quest_desc: ["Somewhere cosy for the cat (or dog) to sleep."]
	quest.34057A5E57B9FAA1.title: "A Pet Bed"
	quest.34057A5E57C036A6.quest_desc: ["Snuffles are fluffy little snow creatures. Some of them are frosty."]
	quest.34057A5E57C036A6.title: "Frosty Fluff"
	quest.34057A5E57C3C45B.quest_desc: ["Keep track of who is related to whom."]
	quest.34057A5E57C3C45B.title: "The Family Tree"
	quest.34057A5E57C4C424.quest_desc: ["Shy big cats of the snowy mountains."]
	quest.34057A5E57C4C424.title: "Snow Leopards"
	quest.34057A5E57CD48D7.quest_desc: ["Levels a dog up further so it can learn more talents."]
	quest.34057A5E57CD48D7.title: "Super Treat"
	quest.34057A5E57DE494A.quest_desc: [
		"Married couples can have children. Babies grow up into villagers of their own."
		"&7In this pack you need to be married first.&r"
	]
	quest.34057A5E57DE494A.title: "A New Arrival"
	quest.34057A5E57E4796D.quest_desc: ["The villagers in this pack talk, have jobs and families, and can become yours."]
	quest.34057A5E57E4796D.title: "Not Alone Out Here"
	quest.34057A5E57E6BD4C.quest_desc: [
		"Villagers sometimes have little jobs for you."
		"[\"\",\"Open the villager quest log with \",{\"keybind\":\"key.mcaquests.quest_log\",\"color\":\"gold\"},\".\"]"
	]
	quest.34057A5E57E6BD4C.title: "Villager Quests"
	quest.34057A5E57E6F745.quest_desc: ["Fill it with food and animals nearby feed and breed themselves."]
	quest.34057A5E57E6F745.title: "Feeding Trough"
	quest.34057A5E57EFDC57.quest_desc: ["Give one to a villager you like to show it."]
	quest.34057A5E57EFDC57.title: "A Bouquet"
	quest.34057A5E57F546A9.quest_desc: ["Tame a horse. Once it's yours you can call it to you from far away (see Keybind Atlas for the key)."]
	quest.34057A5E57F546A9.title: "Your Own Horse"
	quest.34057A5E57F78FFC.quest_desc: ["Give a tamed wolf a training treat to turn it into a Doggy Talents dog."]
	quest.34057A5E57F78FFC.title: "Training Treat"
	quest.34057A5E57F86520.quest_desc: ["Carry animals home."]
	quest.34057A5E57F86520.title: "Lasso"
	quest.34057A5E57F91622.quest_desc: ["Right-click a villager to talk. Chat, joke, give gifts. Their mood toward you goes up (or down)."]
	quest.34057A5E57F91622.title: "Say Hello"
	quest.34057A5E5805196C.quest_desc: ["Every colour at once."]
	quest.34057A5E5805196C.title: "Chromatic Arapaima"
	quest.34057A5E580F5688.quest_desc: ["It glitters."]
	quest.34057A5E580F5688.title: "Crystalline Snakehead"
	quest.34057A5E58153FDE.quest_desc: ["Cooked fillets, a good snack."]
	quest.34057A5E58153FDE.title: "Fish Fillets"
	quest.34057A5E5820A479.quest_desc: ["Hooks change your luck and what you catch."]
	quest.34057A5E5820A479.title: "A Better Hook"
	quest.34057A5E58266163.quest_desc: ["Bites best in bad weather, they say."]
	quest.34057A5E58266163.title: "Storm Tarpon"
	quest.34057A5E582E34C5.quest_desc: ["One eye, lots of fight."]
	quest.34057A5E582E34C5.title: "Cyclops Mahi-Mahi"
	quest.34057A5E583355F1.quest_desc: ["A rare catch full of Neptunium."]
	quest.34057A5E583355F1.title: "Neptune's Bounty"
	quest.34057A5E58392468.quest_desc: ["A rod for serious anglers."]
	quest.34057A5E58392468.title: "Diamond Fishing Rod"
	quest.34057A5E58419E30.quest_desc: ["A rare find in the Sunken Snow Globe."]
	quest.34057A5E58419E30.title: "The Frozen Lure"
	quest.34057A5E58452E65.quest_desc: ["Fishing in this pack is a mini-game: keep the fish in the bar to reel it in."]
	quest.34057A5E58452E65.title: "Gone Fishing"
	quest.34057A5E58454370.quest_desc: ["Made from a guardian. Don't ask."]
	quest.34057A5E58454370.title: "Guardian Soup"
	quest.34057A5E5858C41E.quest_desc: ["Pufferfish, carefully prepared. Very carefully."]
	quest.34057A5E5858C41E.title: "Fugu Roll"
	quest.34057A5E58607EF1.quest_desc: ["Swap hooks, line and bait on your rod."]
	quest.34057A5E58607EF1.title: "Tackle Box"
	quest.34057A5E5873C698.quest_desc: ["Aquaculture rods take hooks, line and bait."]
	quest.34057A5E5873C698.title: "Iron Fishing Rod"
	quest.34057A5E58809B0E.quest_desc: ["Some fish are legendary. This one is enormous."]
	quest.34057A5E58809B0E.title: "A Legendary Fish"
	quest.34057A5E589F57B3.quest_desc: ["Sometimes you pull up a treasure chest."]
	quest.34057A5E589F57B3.title: "Treasure!"
